<ui:FluentWindow x:Class="PyreMedia.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:PyreMedia.App.Controls"
        Title="Settings"
        Height="720" Width="700"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings" ShowMaximize="False" />

        <!-- Grouped rather than one long scroll. Eleven cards in a single
             column meant hunting for the one you wanted, and the window had
             grown a Libraries section, an AcoustID key and an audiobook
             pattern since it was last looked at. -->
        <TabControl Grid.Row="1" x:Name="Tabs" Margin="16,4,16,0" BorderThickness="0"
                    Background="Transparent">

            <TabItem Header="Folders">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10,10,0">
                    <StackPanel>

                        <!-- Folders -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Media folders" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="TV and movies can live together - each item is detected automatically. Loose files in the root are picked up too."
                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ListBox x:Name="FolderList" Height="110" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Add" Click="OnAddFolder" Appearance="Secondary" Margin="0,0,8,0" />
                                    <ui:Button Content="Remove" Click="OnRemoveFolder" Appearance="Secondary" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- Where finished media goes -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Libraries" FontWeight="SemiBold" Margin="0,0,0,2" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Renaming happens where the files already are. These are where &quot;Move completed&quot; sends them afterwards, and leaving them blank is fine - the button asks when it needs one. Four separate folders because they are not interchangeable: Kodi scans films and television separately, and a book filed among the albums is a book nobody finds again." />

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Movies" VerticalAlignment="Center" />
                                    <ui:TextBox Grid.Column="1" x:Name="TxtMovieDest" Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="2" Content="..." Appearance="Secondary"
                                               Padding="12,3" Click="OnPickLibrary" Tag="movie" />
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="TV" VerticalAlignment="Center" />
                                    <ui:TextBox Grid.Column="1" x:Name="TxtTvDest" Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="2" Content="..." Appearance="Secondary"
                                               Padding="12,3" Click="OnPickLibrary" Tag="tv" />
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Music" VerticalAlignment="Center" />
                                    <ui:TextBox Grid.Column="1" x:Name="TxtMusicDest" Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="2" Content="..." Appearance="Secondary"
                                               Padding="12,3" Click="OnPickLibrary" Tag="music" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Audiobooks" VerticalAlignment="Center" />
                                    <ui:TextBox Grid.Column="1" x:Name="TxtBookDest" Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="2" Content="..." Appearance="Secondary"
                                               Padding="12,3" Click="OnPickLibrary" Tag="book" />
                                </Grid>

                            </StackPanel>
                        </ui:Card>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Video">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10,10,0">
                    <StackPanel>

                        <!-- Movies -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Movies" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <CheckBox x:Name="ChkRenameMovies" Content="Rename movie files" Margin="0,0,0,6" />
                                <CheckBox x:Name="ChkKeep3D" Content="Keep 3D tags in filenames, e.g. (3D-HSBS)"
                                          Margin="0,0,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="22,0,0,8"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Half-SBS carries no 3D flag inside the file at all - the filename is the only record. The tag is stripped before searching, then put back on the new name." />
                                <CheckBox x:Name="ChkMove3D" Content="Move 3D files into a subfolder" Margin="0,0,0,6" />
                                <TextBlock Text="Subfolder name for 3D" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtExtrasFolder" Width="200" HorizontalAlignment="Left"
                                            Margin="0,0,0,10" />
                                <CheckBox x:Name="ChkMovieFolderPer" Content="Give each movie its own folder" Margin="0,0,0,10" />

                                <TextBlock Text="Movie file format" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtMovieFileFormat" Margin="0,0,0,10" />
                                <TextBlock Text="Movie folder format" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtMovieFolderFormat" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="{}{title}   {year}" />
                            </StackPanel>
                        </ui:Card>

                        <!-- Naming -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="TV naming" FontWeight="SemiBold" Margin="0,0,0,10" />

                                <TextBlock Text="Filename format" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtFormat" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="{}{title} series   {season} padded   {episode} padded   {name} episode title.  The old {}{0}-{3} numbering still works." />
                                <TextBlock x:Name="TxtFormatPreview" FontSize="11" Margin="0,0,0,12"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Season number padding" Margin="0,0,0,4" />
                                        <ui:NumberBox x:Name="NumSeasonPad" Minimum="0" Maximum="4" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Episode number padding" Margin="0,0,0,4" />
                                        <ui:NumberBox x:Name="NumEpisodePad" Minimum="0" Maximum="4" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Season folder word" Margin="0,0,0,4" />
                                        <ui:TextBox x:Name="TxtSeasonWord" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Specials folder name" Margin="0,0,0,4" />
                                        <ui:TextBox x:Name="TxtSpecials" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Stand-in for characters Windows will not allow" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtReplaceChar" Width="60" HorizontalAlignment="Left"
                                            MaxLength="1" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Episode titles contain : ? / and &quot; often enough to matter, and none of them can appear in a filename. Each becomes this character instead. Films and television only - comics and ebooks replace each character with something chosen to suit it, so a colon becomes a spaced dash rather than whatever is set here." />

                                <CheckBox x:Name="ChkRenameFolder"
                                          Content="Rename the containing folder to match the title"
                                          Margin="0,0,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="22,0,0,8"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Works independently of moving files. Never applies to loose files in a scan root - their folder IS the root." />
                                <TextBlock Text="Show folder format" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtFolderFormat" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="{}{title}   {year}.  &quot;Title (Year)&quot; is what Kodi recommends." />
                            </StackPanel>
                        </ui:Card>

                        <!-- Behaviour -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Behaviour" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <CheckBox x:Name="ChkRename" Content="Rename episode files" Margin="0,0,0,6" />
                                <CheckBox x:Name="ChkMove" Content="Move episodes into season folders" Margin="0,0,0,2" />
                                <TextBlock Text="On by default - Season 01, Season 02 under each show, which is what Kodi, Plex and Jellyfin expect. It also allows the show's own folder to be renamed, so it arranges a library rather than only renaming inside it. Turn it off to rename files exactly where they sit: correct filenames, no season folders, nothing moved. A scan says so when it finds a show keeping its episodes loose, and as always nothing happens until you have read the plan and pressed Apply."
                                           TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="26,0,0,6" />
                                <CheckBox x:Name="ChkFullScreen" Content="Play previews full screen" Margin="0,0,0,2" />
                                <TextBlock Text="Off by default: a preview is usually a glance to settle which episode a file is, and a window you can dismiss suits that better than one that takes the screen. Needs VLC or another player - see Dependencies. Without one the file opens however Windows opens it, and Windows offers no way to ask for full screen."
                                           TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="26,0,0,6" />
                                <CheckBox x:Name="ChkScanOnLaunch" Content="Scan the video folders when the window opens" Margin="0,0,0,2" />
                                <TextBlock Text="On by default. Scanning only reads - nothing is proposed until you pick a match, and nothing happens until Apply. Turn it off if your folders sit on a drive that has to spin up or a share that has to reconnect."
                                           TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="26,0,0,6" />
                                <CheckBox x:Name="ChkAutoAdvance" Content="Move to the next item after Apply" Margin="0,0,0,2" />
                                <TextBlock Text="Off by default. Applying a change and having the selection jump elsewhere takes the item you were just working on off the screen before you have seen what happened to it - the .nfo and the artwork are written straight after the rename, and the row that reports them is the one it has already left. This is the same switch as the tick box beside Apply."
                                           TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="26,0,0,6" />
                                <CheckBox x:Name="ChkOverwrite" Content="Overwrite existing files at the target path" Margin="0,0,0,6" />
                                <CheckBox x:Name="ChkAutoSelect" Content="Automatically pick the first search result" Margin="0,0,0,6" />
                                <CheckBox x:Name="ChkCombineSeasons"
                                          Content="Show a series split across folders as one entry"
                                          Margin="0,0,0,2" />
                                <TextBlock Text="Eight folders of one show become one entry to match. Folders whose year or season numbers disagree are always left separate."
                                           TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="26,0,0,6" />
                            </StackPanel>
                        </ui:Card>

                        <!-- File types -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="File types" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBlock Text="Video extensions (semicolon separated)" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtVideoExt" Margin="0,0,0,10" />
                                <TextBlock Text="Subtitle extensions" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtSubExt" Margin="0,0,0,10" />

                                <CheckBox x:Name="ChkDiscImages" Content="Organise disc images too" Margin="0,0,0,2" />
                                <TextBlock Text="On by default. A folder of .iso files is a shelf of films with nothing tidying them, and naming one needs no more than reading its name. They are named, filed and moved like any film and never opened - remuxing an .iso is not a thing that can happen, and reading one for its tracks reads a filesystem rather than a stream, so they stay out of both."
                                           TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="26,0,0,6" />
                                <TextBlock Text="Disc image extensions" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtDiscExt" />
                            </StackPanel>
                        </ui:Card>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Audio">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10,10,0">
                    <StackPanel>

                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Audiobook naming" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Separate from the music pattern, because a book has no album and no track number worth the name - filing one by them gives a folder called &quot;Unknown Album&quot; holding fifty-seven files called &quot;Track 04&quot;." />
                                <ui:TextBox x:Name="TxtBookFormat" FontFamily="Consolas" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Fields: {author} {book} {narrator} {chapter} {chaptertitle} {year}. Square brackets mark an optional section - it disappears whole when a field inside it is empty." />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Music naming" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Where a track goes under your music folder. The same box is on the Audio tab of the main window, where you can watch a scan use it - this is the same setting, so changing it in either place changes it in both." />

                                <ui:TextBox x:Name="TxtMusicFormat" FontFamily="Consolas"
                                            TextChanged="OnMusicFormatChanged" Margin="0,0,0,4" />

                                <TextBlock x:Name="TxtMusicExample" FontFamily="Consolas" FontSize="12"
                                           Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,2" />
                                <TextBlock x:Name="TxtMusicProblem" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />

                                <WrapPanel Margin="0,10,0,10">
                                    <ui:Button Content="Artist / Album" Appearance="Secondary" Padding="10,3"
                                               Margin="0,0,8,4" Click="OnMusicPreset" Tag="default" />
                                    <ui:Button Content="Under a letter" Appearance="Secondary" Padding="10,3"
                                               Margin="0,0,8,4" Click="OnMusicPreset" Tag="initial" />
                                    <ui:Button Content="Artist - Title" Appearance="Secondary" Padding="10,3"
                                               Margin="0,0,8,4" Click="OnMusicPreset" Tag="artisttitle" />
                                </WrapPanel>

                                <TextBlock FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Fields: {albumartist} {artist} {album} {title} {year} {track} {disc} {genre} {initial}. Pad a number with {track:00}. Square brackets mark an optional section - it disappears whole when a field inside it is empty, so one pattern works whether an album has a year or not." />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="During a scan" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="The three switches - comparing the audio when in doubt, fixing tags inside the files, and evening out the volume - are on the Audio tab, beside the Scan button they change the behaviour of." />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Music needs no account of any kind. The one optional feature that does - identifying files by ear when their tags say nothing - takes a free AcoustID key, on the Metadata tab." />
                            </StackPanel>
                        </ui:Card>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Remux">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10,10,0">
                    <StackPanel>

                        <!-- Language & tracks -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Language and remux" FontWeight="SemiBold" Margin="0,0,0,10" />

                                <TextBlock Text="Your language" Margin="0,0,0,4" />
                                <ctl:LanguagePicker x:Name="PickPreferred" SingleSelect="True" AllowEmpty="False"
                                                    MaxWidth="380" HorizontalAlignment="Left" Margin="0,0,0,12" />

                                <CheckBox x:Name="ChkFlagForeign"
                                          Content="Read each file's tracks after a scan"
                                          Margin="0,0,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="22,0,0,12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="On by default. Shows how many audio and subtitle tracks each item has and what languages they are in, badges anything carrying audio in a language you did not ask for, and spots a 3D file whose name never says so. One probe per item rather than per file, run in the background after the scan is already usable, and abandoned the moment you scan again. Turn it off if your library sits on something slow to read." />

                                <TextBlock Text="Keep audio languages" Margin="0,0,0,4" />
                                <ctl:LanguagePicker x:Name="PickKeepAudio" MaxWidth="380"
                                                    HorizontalAlignment="Left" Margin="0,0,0,12" />
                                <TextBlock Text="Keep subtitle languages" Margin="0,0,0,4" />
                                <ctl:LanguagePicker x:Name="PickKeepSubs" MaxWidth="380"
                                                    HorizontalAlignment="Left" Margin="0,0,0,12" />

                                <CheckBox x:Name="ChkKeepUnd" Content="Keep tracks with no language tag (und)" Margin="0,0,0,6" />
                                <CheckBox x:Name="ChkKeepForced"
                                          Content="Keep forced subtitles in my preferred language" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="22,0,0,10"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Forced tracks carry dialogue you're meant to read - alien speech, on-screen text - so they survive even if the subtitle language rules would drop them. Forced tracks in other languages are still removed." />

                                <CheckBox x:Name="ChkArchive"
                                          Content="Keep the pre-remux file in an archive folder" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="22,0,0,8"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Moved into a hidden subfolder beside the file rather than the Recycle Bin - it survives emptying and has no size cap. The move is instant because it stays on the same drive. Archived files are excluded from scans. Untick to recycle instead." />
                                <TextBlock Text="Archive location (leave empty to keep originals beside each file)"
                                           Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0" x:Name="TxtArchiveRoot"
                                                PlaceholderText="(beside each file)" Margin="0,0,8,0" />
                                    <ui:Button Grid.Column="1" Content="Browse" Click="OnBrowseArchive"
                                               Appearance="Secondary" Margin="0,0,6,0" />
                                    <ui:Button Grid.Column="2" Content="Clear" Click="OnClearArchive"
                                               Appearance="Secondary" />
                                </Grid>
                                <TextBlock x:Name="TxtArchiveWarn" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Visibility="Collapsed" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Subfolder name (when no location set)" Margin="0,0,0,4" />
                                        <ui:TextBox x:Name="TxtArchiveFolder" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Filename suffix" Margin="0,0,0,4" />
                                        <ui:TextBox x:Name="TxtArchiveSuffix" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Dependencies">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10,10,0">
                    <StackPanel>

                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="External tools" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Three programs PyreMedia uses rather than reimplements. None of them ship with it - they have their own licences and their own release schedules, and a copy bundled here would be out of date and unpatched within months. Each says below whether it can actually be found." />

                                                <TextBlock Text="ffmpeg / ffprobe paths" Margin="0,0,0,4" />
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox Grid.Column="0" x:Name="TxtFfmpeg" Margin="0,0,8,0" />
                                                    <ui:TextBox Grid.Column="1" x:Name="TxtFfprobe" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock x:Name="TxtFfmpegStatus" FontSize="11" VerticalAlignment="Center"
                                                               Margin="0,0,10,0" />
                                                    <ui:HyperlinkButton x:Name="LinkFfmpeg" Content="Get ffmpeg"
                                                                        NavigateUri="https://www.gyan.dev/ffmpeg/builds/"
                                                                        FontSize="11" Padding="0" />
                                                </StackPanel>

                                                <CheckBox x:Name="ChkPreferMkv"
                                                          Content="Use mkvmerge for MKV files when available" Margin="0,0,0,4" />
                                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="22,0,0,6"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="mkvmerge copies tracks without decoding them, so 3D MVC survives a remux. ffmpeg only understands the base view and would discard the second eye." />
                                                <TextBlock Text="mkvmerge path" Margin="0,0,0,4" />
                                                <ui:TextBox x:Name="TxtMkvMerge" Margin="0,0,0,4" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="TxtMkvStatus" FontSize="11" VerticalAlignment="Center"
                                                               Margin="0,0,10,0" />
                                                    <ui:HyperlinkButton x:Name="LinkMkv" Content="Get MKVToolNix"
                                                                        NavigateUri="https://mkvtoolnix.download/downloads.html"
                                                                        FontSize="11" Padding="0" />
                                                </StackPanel>

                                                <!-- Optional, and for one repair only. Kept last so it doesn't
                                                     read as another thing that needs installing. -->
                                                <TextBlock Text="dovi_tool path (optional)" Margin="0,12,0,4" />
                                                <ui:TextBox x:Name="TxtDoviTool" Margin="0,0,0,4" />
                                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="Only needed to repair a file that still holds its Dolby Vision data but no longer declares it - what a remux into MP4 leaves behind. Neither ffmpeg nor mkvmerge can rebuild that; this can. There is no winget package, so it's a single file from the author's releases." />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="TxtDoviStatus" FontSize="11" VerticalAlignment="Center"
                                                               Margin="0,0,10,0" />
                                                    <ui:HyperlinkButton x:Name="LinkDovi" Content="Get dovi_tool"
                                                                        NavigateUri="https://github.com/quietvoid/dovi_tool/releases"
                                                                        FontSize="11" Padding="0" />
                                                </StackPanel>

                                                <!-- The Video tab tells people to come here for the player,
                                                     so there has to be somewhere here to put it. -->
                                                <TextBlock Text="Player path (optional)" Margin="0,12,0,4" />
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox x:Name="TxtPlayer" Margin="0,0,6,0"
                                                                PlaceholderText="vlc" />
                                                    <ui:Button Grid.Column="1" Content="..." Appearance="Secondary"
                                                               Padding="10,3" Click="OnPickPlayer" />
                                                </Grid>
                                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="What Play opens a file with. Just &quot;vlc&quot; works when VLC is on the PATH, which a normal install is not - so if Play opens files in whatever Windows would use, point this at vlc.exe. Without a player of its own Play still works; what is lost is control, since Windows offers no way to ask for full screen or to start part-way in." />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="TxtPlayerStatus" FontSize="11" VerticalAlignment="Center"
                                                               Margin="0,0,10,0" />
                                                    <ui:HyperlinkButton Content="Get VLC"
                                                                        NavigateUri="https://www.videolan.org/vlc/"
                                                                        FontSize="11" Padding="0" />
                                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="What stops working without them" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="ffmpeg and ffprobe - remuxing, writing music tags, measuring loudness, reading track lengths, and comparing audio to tell a duplicate from a different version. Without them the music side still reads tags, groups albums, plans and moves; it just judges duplicates on titles and lengths alone, which on a measured library was right 95.2% of the time rather than always." />

                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="mkvmerge - remuxing into Matroska. Preferred where it applies, because ffmpeg parses the video stream and understands only the base view of an MVC 3D file, handing back a 2D copy with the second eye discarded. mkvmerge copies tracks without decoding them." />

                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Text="dovi_tool - optional, and for one repair only: a file that still holds its Dolby Vision data but no longer declares it." />
                            </StackPanel>
                        </ui:Card>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>


            <TabItem Header="Metadata">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10,10,0">
                    <StackPanel>

                        <!-- Cleanup -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="NFO files" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="Kodi-format sidecar metadata. Kodi scrapes for itself, so these matter most for offline libraries or players that only read sidecars."
                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <CheckBox x:Name="ChkWriteNfo" Content="Download metadata and write a .nfo beside each file" Margin="0,0,0,6" />
                                <CheckBox x:Name="ChkMergeNfo"
                                          Content="Combine with an existing .nfo rather than replacing it"
                                          Margin="0,0,0,2" />
                                <TextBlock Text="New titles, plots and stream details are taken; play counts, last played, resume points, ratings and anything hand-added are kept."
                                           TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="26,0,0,6" />
                                <CheckBox x:Name="ChkPreserveNfo" Content="Never overwrite an existing .nfo" Margin="0,0,0,2" />
                                <TextBlock Text="Only applies when combining is off - otherwise there is nothing to lose by writing."
                                           TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="26,0,0,6" />
                                <CheckBox x:Name="ChkDownloadArt" Content="Download poster and fanart beside each file" Margin="0,0,0,6" />
                                <CheckBox x:Name="ChkPreserveArt" Content="Never overwrite artwork that is already there" Margin="0,0,0,6" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Written as &lt;name&gt;-poster.jpg and &lt;name&gt;-fanart.jpg, which is where Kodi looks and which follows the video through a rename. A library Kodi already scrapes has its own; this is for one it doesn't, or for files going to a player that never scrapes." />
                                <CheckBox x:Name="ChkUpdateNfoRemux" Content="Refresh track details in the .nfo after a remux" Margin="0,0,0,0" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Cleanup" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="On by default, and ticked by default - the point of the list is not to forget. Every file still appears as its own row saying exactly what will happen, and clearing the tick is enough to keep it; deletions go to the Recycle Bin where the drive has one, and History will undo them. The one thing not ticked for you is anything sizeable inside Extras, Deleted Scenes, Featurettes and the like, because a deleted scene and a sample clip look alike from the outside and only the folder tells them apart. A .nfo holding real Kodi metadata is never offered: those are told apart by content, not by extension. Nor is a file still being downloaded."
                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <CheckBox x:Name="ChkDeleteSamples" Content="Offer to delete sample clips" Margin="0,0,0,6" />
                                <CheckBox x:Name="ChkDeleteJunk" Content="Offer to delete leftover files (.nfo, .txt, .sfv ...)" Margin="0,0,0,6" />
                                <CheckBox x:Name="ChkRecycleBin" Content="Send deletions to the Recycle Bin"
                                          Margin="0,0,0,6" Checked="OnRecycleBinChanged" Unchecked="OnRecycleBinChanged" />
                                <TextBlock x:Name="TxtRecycleWarn" Visibility="Collapsed"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="Leftover file extensions" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtJunkExt" />
                            </StackPanel>
                        </ui:Card>

                        <!-- Metadata -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Metadata" FontWeight="SemiBold" Margin="0,0,0,10" />

                                <TextBlock Text="Episode data source" Margin="0,0,0,4" />
                                <ComboBox x:Name="CmbSource" Margin="0,0,0,4">
                                    <ComboBoxItem Content="TheTVDB only" />
                                    <ComboBoxItem Content="TMDb only" />
                                    <ComboBoxItem Content="All sources, merged (recommended)" />
                                </ComboBox>
                                <CheckBox x:Name="ChkTvMaze" Content="Use TVmaze as a fallback"
                                          Margin="0,6,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="22,0,0,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Only queried when TMDb and TheTVDB both return nothing. Free, no key. Measured against real shows it added no episodes the other two lacked, so it isn't worth a request on every lookup - but it costs nothing as a safety net." />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Searching always uses TMDb, because TheTVDB retired its search endpoint. This setting controls episode lists only. Merged queries both and combines them - TMDb usually lists more episodes, TheTVDB often has specials TMDb lacks." />

                                <TextBlock Text="My Kodi library scrapes" Margin="0,0,0,4" />
                                <ComboBox x:Name="CmbKodiSource" Margin="0,0,0,4" Width="200" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="TMDb (Kodi default)" />
                                    <ComboBoxItem Content="TheTVDB (separate addon)" />
                                </ComboBox>
                                <CheckBox x:Name="ChkKodiWarn"
                                          Content="Warn when an episode won't match in Kodi" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="22,0,0,12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Merging pulls episodes from several sources. Kodi assigns one scraper per media source - though you can point different sources at different scrapers, and add-ons exist that combine them - so an episode found only elsewhere gets the right filename yet may still show as unmatched, depending on how your library is set up. This flags those in the preview so it isn't a mystery later." />

                                <TextBlock Text="Language" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtLanguage" Width="80" HorizontalAlignment="Left" Margin="0,0,0,12" />

                                <TextBlock Text="TMDb API key  -  required" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtTmdbKey" Margin="0,0,0,2" />
                                <ui:HyperlinkButton Content="themoviedb.org/settings/api"
                                                    NavigateUri="https://www.themoviedb.org/settings/api"
                                                    Padding="0,2" Margin="0,0,0,10" />

                                <TextBlock Text="TheTVDB API key  -  optional, episode data only" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtTvdbKey" Margin="0,0,0,2" />
                                <ui:HyperlinkButton Content="thetvdb.com/api-information/signup"
                                                    NavigateUri="https://thetvdb.com/api-information/signup"
                                                    Padding="0,2" Margin="0,0,0,4" />

                                <TextBlock Text="AcoustID API key  -  optional, music only" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtAcoustIdKey" Margin="0,0,0,2" />
                                <ui:HyperlinkButton Content="acoustid.org/new-application"
                                                    NavigateUri="https://acoustid.org/new-application"
                                                    Padding="0,2" Margin="0,0,0,4" />

                                <!-- The only key here used to ask about the user's own
                                     files rather than about a film or a series, so what
                                     leaves the machine is spelt out where the box is
                                     rather than buried in a manual. -->
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Identifies music with no usable tags by what the audio sounds like. This is the only key here that asks about your own files: what leaves this machine is an acoustic fingerprint and a duration - not the audio, not the filename, not the path - and no audio can be reconstructed from a fingerprint. Album and track names then come from MusicBrainz, which needs no key at all." />

                                <TextBlock FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="All three are free. No key is shipped with the program - a key belongs to the account that registered it, and a shared one gets revoked." />
                            </StackPanel>
                        </ui:Card>

                        <!-- Search term filters -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Search term filters" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Regex of noise removed from a folder name to suggest a search term." />
                                <ui:TextBox x:Name="TxtFilters" TextWrapping="Wrap" AcceptsReturn="True" Height="80" />
                            </StackPanel>
                        </ui:Card>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Comics and books had their sources filed under Metadata, which
                 is a film-and-television word. Somebody setting up comics
                 looked in Metadata last, if at all. -->
            <TabItem Header="Books">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10,10,0">
                    <StackPanel>

                        <!-- These used to sit on the Books tab itself, taking
                             the top third of the working surface and writing to
                             this file on every keystroke. A screen with the
                             settings page on it reads as a settings page. -->
                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Where comics live" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Where .cbz and .cbr files are looked for, and where they go afterwards." />

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtComicFolder" Margin="0,0,6,0"
                                                PlaceholderText="Where your comics are now" />
                                    <ui:Button Grid.Column="1" Content="..." Appearance="Secondary"
                                               Padding="10,3" Click="OnPickBookFolder" Tag="comicsource" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtComicLibrary" Margin="0,0,6,0"
                                                PlaceholderText="Where they should end up" />
                                    <ui:Button Grid.Column="1" Content="..." Appearance="Secondary"
                                               Padding="10,3" Click="OnPickBookFolder" Tag="comiclibrary" />
                                </Grid>

                                <TextBlock Text="Comic filename pattern" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtComicPattern" Margin="0,0,0,4"
                                            TextChanged="OnBookPatternChanged" />
                                <TextBlock x:Name="TxtComicExample" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TxtComicProblem" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Where ebooks live" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="An EPUB knows its own title and author, so the filename is only the fallback." />

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtBookFolder" Margin="0,0,6,0"
                                                PlaceholderText="Where your ebooks are now" />
                                    <ui:Button Grid.Column="1" Content="..." Appearance="Secondary"
                                               Padding="10,3" Click="OnPickBookFolder" Tag="booksource" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtBookLibrary" Margin="0,0,6,0"
                                                PlaceholderText="Where they should end up" />
                                    <ui:Button Grid.Column="1" Content="..." Appearance="Secondary"
                                               Padding="10,3" Click="OnPickBookFolder" Tag="booklibrary" />
                                </Grid>

                                <TextBlock Text="Ebook filename pattern" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtBookPattern" Margin="0,0,0,4"
                                            TextChanged="OnBookPatternChanged" />
                                <TextBlock x:Name="TxtBookExample" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TxtBookProblem" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />

                                <CheckBox x:Name="ChkReadInside" Margin="0,12,0,0"
                                          Content="Open each file and ask what it is" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="26,2,0,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="On by default. Both kinds are zips with metadata inside, and that is a fact where a filename is a guess. Turn it off only if your library sits on a share slow enough that opening every archive is the expensive part." />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Comic sources" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Asked in this order, and the order is by what a question costs rather than by which database is best. The first one that knows the issue answers it - they are not merged. None of this is needed to shelve comics: most already carry their series, issue and publisher inside them, and a scan reads that. These are for the ones that do not, and for checking the ones that do." />

                                <TextBlock Text="Grand Comics Database dump  -  free, local, unlimited" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtGcdPath" Margin="0,0,6,0"
                                                PlaceholderText="Path to the .db file" />
                                    <ui:Button Grid.Column="1" Content="..." Appearance="Secondary"
                                               Padding="10,3" Click="OnPickGcd" />
                                </Grid>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="A SQLite dump of the whole database, about six gigabytes. It is not bundled and could not be: it is CC BY-SA 4.0, which carries attribution and share-alike obligations, so it comes from its own authors the way ffmpeg does. Downloaded once, it answers every question here with no network at all." />
                                <ui:HyperlinkButton Content="Get it from comics.org/download"
                                                    NavigateUri="https://www.comics.org/download/"
                                                    Padding="0,2" Margin="0,0,0,10" />

                                <TextBlock Text="Metron  -  free account, 5,000 questions a day" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0" x:Name="TxtMetronUser" Margin="0,0,6,0"
                                                PlaceholderText="Username" />
                                    <ui:PasswordBox Grid.Column="1" x:Name="TxtMetronPassword"
                                                    PlaceholderText="Password" />
                                </Grid>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Metron authenticates with your account password rather than a key, so this really is the password to that account. It is kept in the settings file in plain text, like every other credential here - if that is not acceptable, leave it empty and use the GCD dump, which needs no account at all." />
                                <ui:HyperlinkButton Content="Sign up at metron.cloud"
                                                    NavigateUri="https://metron.cloud/accounts/signup/"
                                                    Padding="0,2" Margin="0,0,0,10" />

                                <TextBlock Text="Comic Vine  -  free key, 200 questions an hour" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtComicVineKey" Margin="0,0,0,2" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Non-commercial use only - the key is revoked otherwise. Answers are cached so the same issue is never asked about twice. Most comics scraped by ComicRack already carry a Comic Vine id inside them, so this is a lookup rather than a search." />
                                <ui:HyperlinkButton Content="Get a key at comicvine.gamespot.com/api"
                                                    NavigateUri="https://comicvine.gamespot.com/api/"
                                                    Padding="0,2" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="What works without any of them" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Shelving, series grouping, missing-issue detection, the page reader, advert detection and searchable text all work with no source set up at all. They read what is inside the file." />

                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Text="A source adds a second opinion: somewhere to check what a comic claims about itself, and somewhere to ask about the ones that claim nothing. Measured on a real shelf, about 97% of .cbz files already carry their own series and issue - so a source is for the remainder, not for the bulk." />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Ebooks" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Text="No source and no key. An EPUB carries its own title, author and series, which is exact rather than looked up. PDF and Amazon's formats carry nothing this reads, so those are filed from their filenames and say so." />
                            </StackPanel>
                        </ui:Card>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <Border Grid.Row="2" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left, away from Save: a way back when too much has been
                     changed to remember what was changed. -->
                <ui:Button Grid.Column="0" Content="Reset to defaults"
                           Icon="{ui:SymbolIcon ArrowUndo24}"
                           Click="OnResetDefaults" Appearance="Secondary"
                           ToolTip="Put every option back to how it shipped. Your folders are kept, and the current settings are backed up first." />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Content="Cancel" Click="OnCancel" Appearance="Secondary" Margin="0,0,8,0" />
                    <ui:Button Content="Save" Click="OnSave" Appearance="Primary" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
