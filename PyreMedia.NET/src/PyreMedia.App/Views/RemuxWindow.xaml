<ui:FluentWindow x:Class="PyreMedia.App.Views.RemuxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:PyreMedia.App.Controls"
        Title="Remux"
        Height="760" Width="1080"
        MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Remux" ShowMaximize="True" />

        <!-- This rewrites files, so say so plainly and up front -->
        <ui:InfoBar Grid.Row="1" Margin="20,4,20,10" IsOpen="True" IsClosable="False"
                    Severity="Warning" Title="This rewrites your media files"
                    Message="Tracks are removed by remuxing with ffmpeg. No re-encoding, so quality is untouched and it's fast - but dropped tracks are gone. Nothing happens to the file you have until the new one has been written and checked; what becomes of it then is set below. Renaming is unaffected by anything here." />

        <!-- Rules -->
        <ui:Card Grid.Row="2" Margin="20,0,20,10" Padding="14">
            <StackPanel>

                <!-- What becomes of the file as it is now. Shown here rather than
                     asked in a dialog: it is part of the job being set up, and a
                     question you answer once and can never see again is worse
                     than a control you can look at. -->
                <TextBlock Text="The file as it is now" FontWeight="SemiBold" Margin="0,0,0,6" />

                <WrapPanel Margin="0,0,0,2">
                    <RadioButton x:Name="OptKeepBeside" GroupName="Orig" Margin="0,0,18,0"
                                 Checked="OnOriginalChoiceChanged"
                                 Content="Keep in the folder it's in" />
                    <RadioButton x:Name="OptArchive" GroupName="Orig" Margin="0,0,10,0"
                                 Checked="OnOriginalChoiceChanged"
                                 Content="Move to an archive folder" />
                    <ui:Button x:Name="BtnPickArchive" Content="Choose..." Appearance="Secondary"
                               Padding="10,3" Margin="0,0,18,0" Click="OnPickArchive" />
                    <RadioButton x:Name="OptDelete" GroupName="Orig"
                                 Checked="OnOriginalChoiceChanged"
                                 Content="Delete after remuxing" />
                </WrapPanel>

                <TextBlock x:Name="TxtArchiveWhere" TextWrapping="Wrap" Opacity="0.75"
                           FontSize="12" Margin="0,0,0,12" />

                <Separator Margin="0,0,0,12" Opacity="0.35" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Keep audio" VerticalAlignment="Top" Margin="0,6,8,0" />
                    <ctl:LanguagePicker Grid.Column="1" x:Name="PickAudio" Margin="0,0,16,0"
                                        MinWidth="200" MaxWidth="280" VerticalAlignment="Top" />

                    <TextBlock Grid.Column="2" Text="Keep subtitles" VerticalAlignment="Top" Margin="0,6,8,0" />
                    <ctl:LanguagePicker Grid.Column="3" x:Name="PickSubs" Margin="0,0,16,0"
                                        MinWidth="200" MaxWidth="280" VerticalAlignment="Top" />

                    <ui:Button Grid.Column="4" x:Name="BtnAnalyse" Content="Analyse" Icon="{ui:SymbolIcon Search24}"
                               Click="OnAnalyse" Appearance="Primary" />
                </Grid>
            </StackPanel>
        </ui:Card>

        <!-- Layout groups -->
        <ui:Card Grid.Row="3" Margin="20,0,20,10" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="TxtSummary" Margin="14,12,14,8" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Text="Press Analyse to read the track layout of your files." />

                <!-- Skipped files are their own block: appended to the summary
                     they ran off the panel edge, and bolding them buried the
                     headline count. -->
                <ItemsControl Grid.Row="1" x:Name="SkippedList" Margin="14,0,14,10"
                              Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="Info24" FontSize="14" Margin="0,1,7,0"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,0,14,12">
                    <ItemsControl x:Name="GroupList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" CornerRadius="6"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Padding="12,8">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Per-group opt-in. Without it
                                                     Remux was all-or-nothing across
                                                     everything in the window. -->
                                                <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                          Margin="0,0,10,0"
                                                          IsChecked="{Binding Include, Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="Include this group in the next remux" />

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SubHeader}" FontSize="11" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                    <StackPanel Margin="0,8,0,0">
                                        <ItemsControl ItemsSource="{Binding Tracks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="82" />
                                                            <ColumnDefinition Width="74" />
                                                            <ColumnDefinition Width="64" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" Margin="0,0,10,0"
                                                                  ToolTip="Keep this track"
                                                                  IsChecked="{Binding Keep, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanToggle}" />
                                                        <!-- Which track the player picks automatically -->
                                                        <CheckBox Grid.Column="1" Content="default" FontSize="10"
                                                                  VerticalAlignment="Center"
                                                                  ToolTip="Play this track by default"
                                                                  IsChecked="{Binding IsDefault, Mode=TwoWay}"
                                                                  Visibility="{Binding CanBeDefault, Converter={StaticResource BoolToVis}}"
                                                                  IsEnabled="{Binding Keep}" />
                                                        <!-- Inherited from the file and changeable. The flag is
                                                             often wrong, and nothing shows it until you are
                                                             watching: a full track marked forced turns permanent
                                                             subtitles on, and a real one left unmarked leaves the
                                                             alien dialogue untranslated. -->
                                                        <CheckBox Grid.Column="2" Content="forced" FontSize="10"
                                                                  VerticalAlignment="Center"
                                                                  ToolTip="Mark this subtitle track forced - players show it even with subtitles off"
                                                                  IsChecked="{Binding IsForced, Mode=TwoWay}"
                                                                  Visibility="{Binding CanBeForced, Converter={StaticResource BoolToVis}}"
                                                                  IsEnabled="{Binding Keep}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding KindLabel}"
                                                                   FontSize="11" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Grid.Column="4" Text="{Binding Description}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="5" Text="{Binding Note}" FontSize="11"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                                                   TextWrapping="Wrap" MaxWidth="260"
                                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Files sharing this layout, one line each -->
                                        <Expander Header="{Binding FilesHeader}" Margin="0,10,0,0" FontSize="11">
                                            <ItemsControl ItemsSource="{Binding FileNames}" Margin="8,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="11" Margin="0,1"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>

                                        <!-- Worth knowing before you play it, not after -->
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                    Visibility="{Binding HasLanguageWarning, Converter={StaticResource BoolToVis}}">
                                            <ui:SymbolIcon Symbol="Warning24" FontSize="14" VerticalAlignment="Top"
                                                           Margin="0,1,7,0"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                            <TextBlock Text="{Binding LanguageWarning}" FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                        </StackPanel>

                                        <!-- What the name claims that the file doesn't carry. Not
                                             about this remux, but this is where someone is
                                             already looking at what a file is made of. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                    Visibility="{Binding HasMismatch, Converter={StaticResource BoolToVis}}">
                                            <ui:SymbolIcon Symbol="Info24" FontSize="14" VerticalAlignment="Top"
                                                           Margin="0,1,7,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding MismatchWarning}" FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding TitleWarning}" FontSize="11" Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                   Visibility="{Binding HasTitleWarning, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </ui:Card>

        <!-- Progress gets its own full-width row above the buttons. Sharing a
             row with them left the filename and the ETA both clipped mid-word. -->
        <Border Grid.Row="4" Padding="20,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" />
                    <ProgressBar x:Name="Bar" Height="6" Margin="0,8,0,0" Visibility="Collapsed" />
                    <!-- Elapsed / remaining. A file-count alone said nothing about
                         how long a 25 GB remux still had to run. -->
                    <TextBlock x:Name="TxtEta" FontSize="11" Margin="0,6,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Wraps so the stop controls stay reachable when narrow -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="BtnRemux" Content="Remux" Icon="{ui:SymbolIcon Wand24}"
                               Click="OnRemux" Appearance="Primary" Margin="0,0,8,0" IsEnabled="False" />
                    <!-- Two stops, because they differ in what happens to the
                         file currently being written. -->
                    <ui:Button x:Name="BtnStopAfter" Content="Finish this file, then stop"
                               Icon="{ui:SymbolIcon Pause24}"
                               Click="OnStopAfterCurrent" Appearance="Secondary" Margin="0,0,8,0"
                               Visibility="Collapsed"
                               ToolTip="Let the file in progress complete and be saved, then stop. Nothing is wasted." />

                    <ui:Button x:Name="BtnAbort" Content="Abort now"
                               Icon="{ui:SymbolIcon Dismiss24}"
                               Click="OnAbortRemux" Appearance="Danger" Margin="0,0,8,0"
                               Visibility="Collapsed"
                               ToolTip="Kill the running encoder immediately. The part-written file is discarded and the original is left untouched." />
                    <ui:Button x:Name="BtnClose" Content="Close" Click="OnClose" Appearance="Secondary" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
