<ui:FluentWindow x:Class="PyreMedia.App.Views.TidyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Tidy up"
        Height="720" Width="1080"
        MinHeight="440" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Tidy up" ShowMaximize="True" />

        <Border Grid.Row="1" Margin="16,4,16,10" Padding="14,10" CornerRadius="6"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock x:Name="TxtSummary" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Nothing is ticked to begin with, and nothing happens until you press the button. Every row says what was found, why, and what would be done about it. Anything removed goes to the Recycle Bin." />
            </StackPanel>
        </Border>

        <ui:Card Grid.Row="2" Margin="16,0,16,10" Padding="0">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0"
                      Background="Transparent" RowBackground="Transparent"
                      AlternatingRowBackground="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <!-- The tick is the whole interface: this is a list of
                         offers, and an offer you cannot decline is an order. -->
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="ChkAll" Click="OnTickAll" ToolTip="Tick everything" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Disabled for anything that cannot be acted
                                     on, which is how a RAR comic gets listed
                                     without being offered a rebuild it cannot
                                     have. The row still says why. -->
                                <CheckBox IsChecked="{Binding Chosen, Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanChoose}"
                                          HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Kind" Binding="{Binding KindLabel}" Width="120"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Header="What" Binding="{Binding What}" Width="2*"
                                        MinWidth="170" IsReadOnly="True" />
                    <DataGridTextColumn Header="Why" Binding="{Binding Why}" Width="3*"
                                        MinWidth="220" IsReadOnly="True" />
                    <DataGridTextColumn Header="What would happen" Binding="{Binding Will}"
                                        Width="3*" MinWidth="220" IsReadOnly="True" />
                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80"
                                        IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </ui:Card>

        <Border Grid.Row="3" Padding="16,8,16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ProgressRing x:Name="Busy" IsIndeterminate="True" Width="16" Height="16"
                                     Margin="0,0,10,0" Visibility="Collapsed" />
                    <TextBlock x:Name="TxtChosen" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="BtnDo" Content="Do the ticked ones" Click="OnDo"
                               Appearance="Primary" Margin="0,0,8,0" IsEnabled="False" />
                    <ui:Button Content="Close" Click="OnClose" Appearance="Secondary" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
