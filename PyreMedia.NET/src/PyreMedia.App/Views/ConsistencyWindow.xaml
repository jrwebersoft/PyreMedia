<ui:FluentWindow x:Class="PyreMedia.App.Views.ConsistencyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Files that disagree with their neighbours"
        Height="700" Width="1100"
        MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Files that disagree with their neighbours"
                     ShowMaximize="True" />

        <!-- The point of this screen, said before anything is ticked. Nothing
             here is a correction; the set can be wrong as easily as the file. -->
        <ui:InfoBar Grid.Row="1" Margin="20,4,20,10" IsOpen="True" IsClosable="False"
                    Severity="Warning" Title="These are proposals, not corrections"
                    Message="Each row is a file that disagrees with the rest of its album or series. The suggestion is whatever most of the set says - and the majority is not always right. In this library thirteen files spell a band &quot;Cherry Poppin Daddies&quot; and one spells it &quot;Cherry Poppin' Daddies&quot;; the one is correct. Read every row before ticking it." />

        <Border Grid.Row="2" Padding="20,0,20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Ticks what is on screen rather than everything, so it
                         follows the filter beside it: "tick all the spellings"
                         is a reasonable thing to mean, "tick all 82 of these
                         sight unseen" mostly is not. -->
                    <ui:Button x:Name="BtnAll" Content="Tick all shown" Appearance="Secondary"
                               Padding="10,3" Margin="0,0,8,0" Click="OnAll" />
                    <ui:Button Content="Tick none" Appearance="Secondary" Padding="10,3"
                               Margin="0,0,8,0" Click="OnNone" />
                    <ComboBox x:Name="KindFilter" Width="200" SelectionChanged="OnFilter" />
                </StackPanel>

                <TextBlock Grid.Column="2" x:Name="TxtCount" VerticalAlignment="Center"
                           Opacity="0.8" />
            </Grid>
        </Border>

        <DataGrid Grid.Row="3" x:Name="Grid" Margin="20,0,20,10"
                  AutoGenerateColumns="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" Background="Transparent"
                  BorderThickness="0" RowHeight="40" CanUserSortColumns="True">
            <DataGrid.Columns>
                <!-- Wide enough for the themed checkbox to draw. At 44 it was
                     squeezed to a sliver: the style reserves room for a label
                     even when there is no label, so the box itself was being
                     clipped to a bracket. -->
                <DataGridTemplateColumn Width="64" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Approved, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="10,0,0,0" MinWidth="0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="130" IsReadOnly="True" />
                <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="Files" Binding="{Binding Count}" Width="60" IsReadOnly="True" />
                <DataGridTextColumn Header="Now" Binding="{Binding Value}" Width="2*" IsReadOnly="True" />
                <DataGridTextColumn Header="Would become" Binding="{Binding Suggested}" Width="2*" IsReadOnly="True" />
                <DataGridTextColumn Header="Because" Binding="{Binding Why}" Width="3*" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" Padding="20,0,20,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="TxtTicked" VerticalAlignment="Center" Margin="0,0,16,0"
                           Opacity="0.8" />
                <ui:Button Content="Cancel" Appearance="Secondary" Padding="16,5"
                           Margin="0,0,8,0" Click="OnCancel" />
                <ui:Button x:Name="BtnApply" Content="Write the ticked ones"
                           Appearance="Primary" Padding="16,5" Click="OnApply" IsEnabled="False" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
