<UserControl x:Class="PyreMedia.App.Views.BooksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- The working surface carries no settings. Folders, destinations, naming
         patterns and the read-inside switch all moved to Settings > Books,
         where the comic sources already were. They took up the top third of
         this screen and every one of them wrote to the settings file, which is
         what made this read as a settings page with a Scan button rather than
         somewhere work happens. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="16,2,16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Comics and books are shelved differently and read by
                     different programs, so the filter is a real division
                     rather than a view of one list. -->
                <Border Grid.Column="0" CornerRadius="6" Margin="0,0,14,0" Padding="3"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FilterAll" Content="All" GroupName="Shelf" Padding="12,4"
                                     IsChecked="True" Checked="OnFilterChanged"
                                     Style="{StaticResource ModeToggle}" />
                        <RadioButton x:Name="FilterComics" Content="Comics" GroupName="Shelf" Padding="12,4"
                                     Checked="OnFilterChanged" Style="{StaticResource ModeToggle}" />
                        <RadioButton x:Name="FilterBooks" Content="Ebooks" GroupName="Shelf" Padding="12,4"
                                     Checked="OnFilterChanged" Style="{StaticResource ModeToggle}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="BtnScan" Icon="{ui:SymbolIcon ArrowSync24}" Content="Scan"
                               Click="OnScan" Appearance="Primary" Margin="0,0,8,0" />
                    <!-- What the video tab does with a show: look the series up
                         and agree which one it is, once, for every issue of it. -->
                    <ui:Button x:Name="BtnMatch" Content="Match" Icon="{ui:SymbolIcon Search24}"
                               Click="OnMatch" Appearance="Secondary" Margin="0,0,8,0"
                               ToolTip="Look the chosen series up in a comic database and agree which run it is" />

                    <ui:Button x:Name="BtnRead" Content="Read" Icon="{ui:SymbolIcon BookOpen24}"
                               Click="OnRead" Appearance="Secondary" Margin="0,0,8,0"
                               IsEnabled="False"
                               ToolTip="Look through the pages, and drop the adverts" />
                    <ui:Button x:Name="BtnApply" Content="Apply" Icon="{ui:SymbolIcon Checkmark24}"
                               Click="OnApply" Appearance="Secondary" Margin="0,0,8,0" IsEnabled="False" />

                    <ui:Button x:Name="BtnAll" Content="All" Click="OnTickAll"
                               Appearance="Secondary" Margin="0,0,4,0" Padding="10,6"
                               ToolTip="Tick every row that would move" />
                    <ui:Button x:Name="BtnNone" Content="None" Click="OnTickNone"
                               Appearance="Secondary" Margin="0,0,8,0" Padding="10,6"
                               ToolTip="Untick everything" />

                    <!-- The words. Separate from Apply because it takes minutes
                         over a shelf and changes nothing about where files go. -->
                    <ui:Button x:Name="BtnIndex" Content="Read the words"
                               Icon="{ui:SymbolIcon TextBulletListSquare24}"
                               Click="OnIndex" Appearance="Secondary" Margin="0,0,8,0"
                               ToolTip="Writes a script beside each comic and book for another program to index" />

                    <ui:Button x:Name="BtnTidy" Content="Tidy up"
                               Icon="{ui:SymbolIcon Broom24}"
                               Click="OnTidy" Appearance="Secondary" Margin="0,0,8,0"
                               ToolTip="Adverts left in comics, images a release left behind, and comics nobody packed" />

                    <!-- Reading a shelf's words is measured in hours, and there
                         was no way to stop it once started. -->
                    <ui:Button x:Name="BtnCancel" Content="Stop"
                               Icon="{ui:SymbolIcon Dismiss24}"
                               Click="OnCancel" Appearance="Secondary"
                               Visibility="Collapsed"
                               ToolTip="Stop after the file being read now" />
                </StackPanel>

                <Grid Grid.Column="2" Margin="20,0,10,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <ui:ProgressRing x:Name="Busy" IsIndeterminate="True" Width="16" Height="16"
                                         Margin="0,0,10,0" Visibility="Collapsed" />
                        <TextBlock x:Name="TxtStatus" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtEta" Margin="10,0,0,0" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <!-- Only once the walk has counted. Until then there is no
                         total, and a bar that cannot say how far through it is
                         says only that the program has not crashed. -->
                    <ProgressBar Grid.Row="1" x:Name="Bar" Height="4" Margin="0,5,0,0"
                                 Minimum="0" Maximum="1" Visibility="Collapsed" />
                </Grid>

                <ui:Button Grid.Column="3" Content="Settings" Icon="{ui:SymbolIcon Settings24}"
                           Click="OnSettings" Appearance="Secondary" />
            </Grid>
        </Border>


        <!-- Series on the left, issues on the right - the same shape the video
             tab uses for shows and episodes, because it is the same question. -->
        <Grid Grid.Row="1" Margin="16,0,16,10">
            <!-- The right pane starts wide because a comic page is tall and
                 narrow and a pane that fits one is worth more than a wider list
                 of filenames. Both splitters drag, and either pane can be taken
                 down to nothing if that is what is wanted. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1.6*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12,10,12,8">
                        <StackPanel>
                            <TextBlock x:Name="TxtSeriesCount" FontWeight="SemiBold" />
                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Pick one to see only its issues. Gaps are counted from what the comics themselves say the run is, never from what happens to be here." />
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="SeriesList" BorderThickness="0"
                             Background="Transparent" SelectionChanged="OnSeriesPicked"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.ScrollChanged="OnSeriesScrolled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Page one of the lowest issue held, taken
                                         out of the comic itself. No network, no
                                         key, and it is the actual cover of the
                                         actual file rather than a picture of
                                         some other edition. -->
                                    <Border Grid.Column="0" Width="46" Height="70" CornerRadius="3"
                                            Margin="0,0,10,0" ClipToBounds="True"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <Grid>
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />

                                            <!-- A row that is silently empty for
                                                 a minute looks like one that
                                                 failed, so it says which it is. -->
                                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16"
                                                             Visibility="{Binding Fetching,
                                                                 Converter={StaticResource BoolToVis}}" />

                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18" Opacity="0.35"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       ToolTip="No cover could be read from this one"
                                                       Visibility="{Binding NoCover,
                                                           Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{Binding Tone}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </ui:Card>

            <!-- Visible, because a transparent six-pixel strip is a handle
                 nobody finds. -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Cursor="SizeWE"
                          Background="{DynamicResource ControlFillColorDefaultBrush}"
                          Margin="2,0" ToolTip="Drag to resize" />

            <!-- Six columns in a narrow middle pane meant every one of them was
                 an ellipsis: Kind and Read from collapsed to a single character
                 and Would become had no room at all. The series is already named
                 above and the file is shown on the right, so what is left here
                 is the issue, what it would become, and anything against it.
                 The rest moved into the row's tooltip, where it costs nothing. -->
            <ui:Card Grid.Column="2" Padding="0">
                <DataGrid x:Name="GridPlan" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0"
                          Background="Transparent" RowBackground="Transparent"
                          AlternatingRowBackground="Transparent"
                          SelectionChanged="OnSelectionChanged"
                          FontSize="11" RowHeight="26"
                          ColumnHeaderHeight="28"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding Detail}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- Per row, the way the video grid has always worked.
                             Apply used to take every row on screen, so one
                             obviously wrong issue in a run of forty-eight meant
                             applying the lot or narrowing the filter until it
                             was somewhere else. -->
                        <DataGridTemplateColumn Width="34" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Chosen, Mode=TwoWay,
                                                  UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanChoose}"
                                              HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Issue" Binding="{Binding Issue}"
                                            IsReadOnly="True" Width="1.4*" MinWidth="90" />

                        <!-- What Apply would do, rather than leaving it to be
                             worked out from an empty "Why not" column. -->
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}"
                                            IsReadOnly="True" Width="Auto" MinWidth="0" />
                        <DataGridTextColumn Header="Found in it" Binding="{Binding Flagged}"
                                            IsReadOnly="True" Width="Auto" MinWidth="0" />
                        <DataGridTextColumn Header="Would become" Binding="{Binding Becomes}"
                                            IsReadOnly="True" Width="2*" MinWidth="110" />
                        <DataGridTextColumn Header="Why not" Binding="{Binding Held}"
                                            IsReadOnly="True" Width="1.3*" MinWidth="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </ui:Card>

            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Cursor="SizeWE"
                          Background="{DynamicResource ControlFillColorDefaultBrush}"
                          Margin="2,0" ToolTip="Drag to make the page bigger" />

            <!-- The issue itself, as big as the window allows. Picking a row in
                 the middle and getting nothing but another row of text is what
                 made this a spreadsheet; a comic is a picture and the pane
                 that shows it is what makes this a workbench. -->
            <ui:Card Grid.Column="4" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" ClipToBounds="True"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Grid>
                            <Image x:Name="Peek" Stretch="Uniform" Margin="6"
                                   MouseLeftButtonDown="OnPeekClicked" />

                            <TextBlock x:Name="TxtPeekNothing" TextWrapping="Wrap" Margin="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Pick a comic on the left to look through it here." />

                            <ui:ProgressRing x:Name="PeekBusy" IsIndeterminate="True"
                                             Width="22" Height="22" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:Button Grid.Column="0" x:Name="BtnPeekBack" Content="&#xE76B;"
                                       FontFamily="Segoe MDL2 Assets" Click="OnPeekBack"
                                       Appearance="Secondary" Padding="10,4" IsEnabled="False" />

                            <TextBlock Grid.Column="1" x:Name="TxtPeekWhere" Margin="10,0"
                                       VerticalAlignment="Center" FontSize="12"
                                       TextTrimming="CharacterEllipsis" />

                            <ui:Button Grid.Column="2" x:Name="BtnPeekForward" Content="&#xE76C;"
                                       FontFamily="Segoe MDL2 Assets" Click="OnPeekForward"
                                       Appearance="Secondary" Padding="10,4" Margin="0,0,8,0"
                                       IsEnabled="False" />

                            <ui:Button Grid.Column="3" x:Name="BtnPeekOpen" Content="Open"
                                       Click="OnRead" Appearance="Secondary" IsEnabled="False"
                                       ToolTip="Open it properly - full screen, page removal, advert detection" />
                        </Grid>
                    </Border>
                </Grid>
            </ui:Card>
        </Grid>

        <Expander Grid.Row="2" Header="Log" Margin="16,0,16,12">
            <TextBox x:Name="TxtLog" IsReadOnly="True" Height="120" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="11" />
        </Expander>
    </Grid>
</UserControl>
