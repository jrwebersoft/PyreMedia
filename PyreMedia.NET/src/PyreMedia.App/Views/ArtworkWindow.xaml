<ui:FluentWindow x:Class="PyreMedia.App.Views.ArtworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Artwork"
        Height="800" Width="1060"
        MinHeight="460" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Artwork" ShowMaximize="True" />

        <!-- What you're looking at, and what each kind is for. "Fanart" and
             "clear logo" mean nothing until someone says so. -->
        <Border Grid.Row="1" Margin="20,4,20,8" Padding="14,12" CornerRadius="6"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" x:Name="TxtTitle" FontWeight="SemiBold" FontSize="15"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:ProgressRing x:Name="Spinner" IsIndeterminate="True"
                                         Width="18" Height="18" Margin="0,0,10,0"
                                         Visibility="Collapsed" />
                        <TextBlock x:Name="TxtScope" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Step 1 -->
                <TextBlock Text="1.  Pick a kind" FontSize="11" Margin="0,12,0,6"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbPoster" GroupName="Kind" IsChecked="True"
                                 Padding="14,4" FontSize="12" Margin="0,0,6,0"
                                 Style="{StaticResource ModeToggle}" Checked="OnKindChanged" />
                    <RadioButton x:Name="RbFanart" GroupName="Kind"
                                 Padding="14,4" FontSize="12" Margin="0,0,6,0"
                                 Style="{StaticResource ModeToggle}" Checked="OnKindChanged" />
                    <RadioButton x:Name="RbLogo" GroupName="Kind"
                                 Padding="14,4" FontSize="12"
                                 Style="{StaticResource ModeToggle}" Checked="OnKindChanged" />
                </StackPanel>

                <TextBlock x:Name="TxtKindHelp" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Step 2: narrow the wall down. Two hundred posters is not a choice,
             it's a search - and most of them differ only by language. -->
        <Border Grid.Row="2" Margin="20,0,20,8" Padding="14,10" CornerRadius="6"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                x:Name="FilterBar">
            <StackPanel>
                <TextBlock Text="2.  Narrow it down" FontSize="11" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <ItemsControl x:Name="LangChips">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton IsChecked="{Binding IsOn, Mode=OneWay}"
                                          Content="{Binding Label}" Tag="{Binding}"
                                          Click="OnLangChip"
                                          Margin="0,0,6,4" Padding="12,3" FontSize="12"
                                          MinWidth="0" Cursor="Hand" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Step 3 -->
        <ui:Card Grid.Row="3" Margin="20,0,20,8" Padding="0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <ItemsControl x:Name="Gallery">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6" Padding="5" CornerRadius="8" Cursor="Hand"
                                        BorderThickness="3"
                                        BorderBrush="{Binding BorderBrush}"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        MouseLeftButtonUp="OnPick" Tag="{Binding}"
                                        ToolTip="{Binding Tip}">
                                    <StackPanel Width="184">
                                        <Grid>
                                            <Border Height="130" CornerRadius="4"
                                                    Background="{Binding Backdrop}">
                                                <Image Source="{Binding Thumb}" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>

                                            <!-- A tick is readable at a glance in a way a
                                                 coloured edge alone is not. -->
                                            <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                                    Margin="6" Padding="6,2" CornerRadius="10"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    Visibility="{Binding IsChosen, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding Badge}" FontSize="10"
                                                           FontWeight="SemiBold" Foreground="White" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding Caption}" FontSize="11" Margin="2,6,2,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="TxtEmpty" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
        </ui:Card>

        <!-- Step 3: what will actually happen, stated before it does -->
        <Border Grid.Row="4" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="3.  Save" FontSize="11" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ItemsControl x:Name="Summary">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,0" Padding="9,2" CornerRadius="10"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <TextBlock Text="{Binding Text}" FontSize="11"
                                               Foreground="{Binding Brush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TxtStatus" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnApply" Content="Save artwork"
                               Icon="{ui:SymbolIcon Save24}" Click="OnApply"
                               Appearance="Primary" Margin="0,0,8,0" IsEnabled="False" />
                    <ui:Button Content="Close" Click="OnClose" Appearance="Secondary" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
