<ui:FluentWindow x:Class="PyreMedia.App.Views.EpisodeMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Renumber episodes"
        Height="760" Width="1180"
        MinHeight="420" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Renumber episodes" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="NumberSymbol24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Source: the whole reason this screen exists is that providers
             disagree about numbering, so switching must be one click. -->
        <Border Grid.Row="1" Margin="16,4,16,10" Padding="12,10" CornerRadius="6"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Numbering from" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,10,0" />

                <ComboBox Grid.Column="1" x:Name="CmbSource" Width="200"
                          SelectionChanged="OnSourceChanged" />

                <!-- Seasons are numbered, and misnumbered, independently, so they get
                     worked through one at a time. Chips rather than a list: several
                     can be on at once, and which are on is visible without opening
                     anything. The episode dropdown on each row still reaches every
                     season, for files that landed in the wrong one entirely. -->
                <TextBlock Grid.Column="2" x:Name="LblSeasons" Text="Seasons" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="20,0,10,0" />

                <ItemsControl Grid.Column="3" x:Name="SeasonChips" VerticalAlignment="Center"
                              ItemsSource="{Binding Seasons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton IsChecked="{Binding IsOn, Mode=TwoWay}"
                                          Content="{Binding Label}"
                                          Click="OnSeasonChipToggled"
                                          Margin="0,0,6,0" Padding="10,3" FontSize="12"
                                          MinWidth="0" Cursor="Hand" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Column="4" x:Name="TxtShow" VerticalAlignment="Center"
                           Margin="16,0,16,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <ui:ProgressRing Grid.Column="5" x:Name="Spinner" IsIndeterminate="True"
                                 Width="18" Height="18" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Bulk tools -->
        <Border Grid.Row="2" Margin="16,0,16,10" Padding="12,10" CornerRadius="6"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <WrapPanel Orientation="Horizontal">
                <ui:Button x:Name="BtnMatchTitles" Content="Match by title"
                           Icon="{ui:SymbolIcon Search24}"
                           Appearance="Primary" Click="OnMatchByTitle" Margin="0,0,8,0"
                           ToolTip="Read the episode title out of each filename and line it up with the metadata" />

                <ui:Button Content="Sequential" Icon="{ui:SymbolIcon ArrowSync24}"
                           Appearance="Secondary" Click="OnSequential" Margin="0,0,16,0"
                           ToolTip="Assign episodes in order, following the order on screen. Select rows with Ctrl or Shift to do only those." />

                <TextBlock Text="Shift all by" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ui:Button Content="-1" Click="OnShiftDown" Appearance="Secondary" Margin="0,0,4,0" />
                <ui:Button Content="+1" Click="OnShiftUp" Appearance="Secondary" Margin="0,0,8,0" />
                <ui:Button Content="Reset" Icon="{ui:SymbolIcon ArrowUndo24}"
                           Click="OnResetAll" Appearance="Secondary" Margin="0,0,16,0"
                           ToolTip="Back to what the filenames say. Select rows with Ctrl or Shift to reset only those." />

                <!-- The whole-season move. Shifting by one thirteen times was
                     the only way to say "these are season 2, not season 1", and
                     it walked through the season boundary to get there. -->
                <TextBlock Text="Move to season" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ui:TextBox x:Name="TxtMoveSeason" Width="52" Margin="0,0,4,0"
                            PlaceholderText="2"
                            ToolTip="The season these files really belong to" />
                <ui:Button Content="Move" Icon="{ui:SymbolIcon ArrowMove24}"
                           Click="OnMoveSeason" Appearance="Secondary" Margin="0,0,16,0"
                           ToolTip="Keep each episode number, but read them as another season. Select rows with Ctrl or Shift to move only those." />

                <ui:Button Content="Include all" Click="OnIncludeAll" Appearance="Secondary" Margin="0,0,4,0" />
                <ui:Button Content="Exclude all" Click="OnExcludeAll" Appearance="Secondary" />
            </WrapPanel>
        </Border>

        <ui:Card Grid.Row="3" Margin="16,0,16,10" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="TxtSummary" Margin="14,12,14,8"
                               FontWeight="SemiBold" TextWrapping="Wrap" />

                    <!-- What a disc could not tell us. Above the grid rather
                         than in a tooltip, because a wrongly numbered rip looks
                         entirely correct afterwards - the files play, the names
                         read properly, and the mistake surfaces weeks later. -->
                    <Border x:Name="RipCautionBox" Visibility="Collapsed"
                            Margin="14,0,14,10" Padding="12,8" CornerRadius="6"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                        <TextBlock x:Name="RipCaution" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    </Border>
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="None" BorderThickness="0"
                          Background="Transparent" RowBackground="Transparent"
                          AlternatingRowBackground="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectionMode="Extended"
                          SelectionChanged="OnGridSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Use"
                                                Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}"
                                                Width="44" CanUserSort="False" />

                        <DataGridTextColumn Header="Current file" Binding="{Binding FileName}"
                                            Width="*" MinWidth="200" IsReadOnly="True" />

                        <DataGridTextColumn Header="Title read from name"
                                            Binding="{Binding ExtractedTitle}"
                                            Width="170" IsReadOnly="True" />

                        <!-- The fine-tune control: every episode, pick one -->
                        <DataGridTemplateColumn Header="Episode" Width="270">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.AllEpisodes,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Chosen, Mode=TwoWay,
                                                  UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding Include}"
                                              Margin="0,3" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Match" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ConfidenceLabel}"
                                               Foreground="{Binding ConfidenceBrush}"
                                               ToolTip="{Binding AlternativeLabel}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Renames to" Binding="{Binding NewName}"
                                            Width="*" MinWidth="200" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </ui:Card>

        <Border Grid.Row="4" Padding="16,0,16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="TxtHint" VerticalAlignment="Center"
                           TextWrapping="Wrap" FontSize="12" Margin="0,0,16,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Nothing is written here. Use these numbers builds the preview on the main screen - you still press Apply there." />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="BtnOk" Content="Use these numbers"
                               Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary"
                               Click="OnAccept" Margin="0,0,8,0" />
                    <ui:Button Content="Cancel" Click="OnCancel" Appearance="Secondary" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
