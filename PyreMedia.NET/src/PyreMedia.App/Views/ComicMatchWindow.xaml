<ui:FluentWindow x:Class="PyreMedia.App.Views.ComicMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Match a series"
        Height="720" Width="980"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Match a series" ShowMaximize="True" />

        <!-- What is being matched, and what to look for -->
        <Border Grid.Row="1" Margin="16,4,16,10" Padding="14,12" CornerRadius="6"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock x:Name="TxtShelf" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                <TextBlock x:Name="TxtHeld" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0" x:Name="TxtTerm" PlaceholderText="Series name"
                                KeyDown="OnTermKey" />
                    <ui:TextBox Grid.Column="1" x:Name="TxtYear" PlaceholderText="Year"
                                Width="90" Margin="8,0,0,0" KeyDown="OnTermKey" />
                    <ui:Button Grid.Column="2" x:Name="BtnSearch" Content="Search"
                               Icon="{ui:SymbolIcon Search24}" Appearance="Primary"
                               Margin="8,0,0,0" Click="OnSearch" />
                </Grid>

                <TextBlock x:Name="TxtSources" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <!-- Where to get them, on the screen where you find out you
                     need them. Settings has these links too, but being told
                     to go and look somewhere else for a link is the step
                     people give up on. -->
                <WrapPanel x:Name="Signup" Margin="0,4,0,0" Visibility="Collapsed">
                    <ui:HyperlinkButton Content="Grand Comics Database - free, no key"
                                        NavigateUri="https://www.comics.org/download/"
                                        Padding="0,2" Margin="0,0,14,0"
                                        ToolTip="A database dump you download once. No key, no rate limit, and it answers in milliseconds." />

                    <ui:HyperlinkButton Content="Metron - free account"
                                        NavigateUri="https://metron.cloud/accounts/signup/"
                                        Padding="0,2" Margin="0,0,14,0"
                                        ToolTip="Five thousand questions a day" />

                    <ui:HyperlinkButton Content="Comic Vine - free key"
                                        NavigateUri="https://comicvine.gamespot.com/api/"
                                        Padding="0,2"
                                        ToolTip="Two hundred an hour, and the key is revoked if used commercially" />
                </WrapPanel>

                <ui:Button x:Name="BtnSettings" Content="Open Settings" Appearance="Secondary"
                           Icon="{ui:SymbolIcon Settings24}" Margin="0,8,0,0"
                           HorizontalAlignment="Left" Visibility="Collapsed"
                           Click="OnSettings" />
            </StackPanel>
        </Border>

        <!-- Candidates on the left, what was chosen on the right -->
        <Grid Grid.Row="2" Margin="16,0,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0" Padding="0">
                <Grid>
                    <ListBox x:Name="Hits" SelectionChanged="OnPicked"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,6">
                                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="TxtNothing" Margin="20" TextWrapping="Wrap" FontSize="12"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <ui:ProgressRing x:Name="Busy" IsIndeterminate="True" Width="28" Height="28"
                                     Visibility="Collapsed" />
                </Grid>
            </ui:Card>

            <!-- The one being agreed to, before anything is applied -->
            <ui:Card Grid.Column="1" Margin="12,0,0,0" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="What this would become" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <TextBlock x:Name="TxtChosen" FontSize="16" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Nothing chosen yet." />

                        <TextBlock x:Name="TxtChosenWhere" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,8,0,0" FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <Border x:Name="RunBox" Margin="0,14,0,0" Padding="12,10" CornerRadius="6"
                                Visibility="Collapsed"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock x:Name="TxtRun" FontSize="12" TextWrapping="Wrap"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtGaps" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="TxtNote" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>
        </Grid>

        <Border Grid.Row="3" Padding="16,10,16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- For a series that was matched before and should not be -->
                <ui:Button Grid.Column="0" x:Name="BtnForget" Content="Forget the match"
                           Appearance="Secondary" Click="OnForget" Visibility="Collapsed"
                           ToolTip="Go back to using what the files themselves say" />

                <TextBlock Grid.Column="1" x:Name="TxtStatus" VerticalAlignment="Center"
                           Margin="12,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button x:Name="BtnUse" Content="Use this one" Appearance="Primary"
                               Click="OnUse" IsEnabled="False" Margin="0,0,8,0" />
                    <ui:Button Content="Cancel" Appearance="Secondary" Click="OnCancel" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
