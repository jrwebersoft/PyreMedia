<ui:FluentWindow x:Class="PyreMedia.App.Views.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Files already exist"
        Icon="../pyremedia.ico"
        Height="700" Width="1000"
        MinHeight="400" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Files already exist" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Warning24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:InfoBar Grid.Row="1" Margin="16,4,16,10" IsOpen="True" IsClosable="False"
                    Severity="Warning"
                    Title="Something is already there"
                    Message="Choose what happens to each one. Nothing is written until you press Continue, and every choice can be undone afterwards from History." />

        <!-- Answer everything at once, since most runs want the same answer -->
        <Border Grid.Row="2" Margin="16,0,16,10" Padding="12,10" CornerRadius="6"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtCount" VerticalAlignment="Center" FontWeight="SemiBold"
                           Margin="0,0,16,0" />

                <TextBlock Text="Do this for all:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <ui:Button Content="Keep both" Icon="{ui:SymbolIcon Copy24}"
                           Click="OnAllKeepBoth" Appearance="Secondary" Margin="0,0,6,0"
                           ToolTip="Rename the incoming file to &quot;name (2)&quot; so nothing is lost" />
                <ui:Button Content="Replace" Icon="{ui:SymbolIcon ArrowSwap24}"
                           Click="OnAllReplace" Appearance="Secondary" Margin="0,0,6,0"
                           ToolTip="The existing file is archived or recycled first - never deleted outright" />
                <ui:Button Content="Skip" Icon="{ui:SymbolIcon Prohibited24}"
                           Click="OnAllSkip" Appearance="Secondary" Margin="0,0,16,0"
                           ToolTip="Leave both files exactly as they are" />

                <ui:Button Content="Keep the newer" Icon="{ui:SymbolIcon Clock24}"
                           Click="OnAllNewer" Appearance="Secondary" Margin="0,0,6,0"
                           ToolTip="Replace when the incoming file is newer, skip when it isn't" />
                <ui:Button Content="Keep the larger" Icon="{ui:SymbolIcon ArrowUp24}"
                           Click="OnAllLarger" Appearance="Secondary"
                           ToolTip="Replace when the incoming file is bigger, skip when it isn't" />
            </WrapPanel>
        </Border>

        <ui:Card Grid.Row="3" Margin="16,0,16,10" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Headline}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />

                                    <!-- Both files side by side, so the choice can be
                                         made without leaving the dialog -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Incoming" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding IncomingDetail}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Already there" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding ExistingDetail}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />

                                    <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <RadioButton Content="Keep both" Margin="0,0,14,0"
                                                     GroupName="{Binding GroupName}"
                                                     IsChecked="{Binding IsKeepBoth, Mode=TwoWay}" />
                                        <RadioButton Content="Replace" Margin="0,0,14,0"
                                                     GroupName="{Binding GroupName}"
                                                     IsChecked="{Binding IsReplace, Mode=TwoWay}" />
                                        <RadioButton Content="Skip"
                                                     GroupName="{Binding GroupName}"
                                                     IsChecked="{Binding IsSkip, Mode=TwoWay}" />
                                    </WrapPanel>

                                    <TextBlock Text="{Binding Outcome}" FontSize="11" Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </ui:Card>

        <Border Grid.Row="4" Padding="16,0,16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="TxtSummary" VerticalAlignment="Center"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,16,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="BtnOk" Content="Continue" Icon="{ui:SymbolIcon Checkmark24}"
                               Click="OnAccept" Appearance="Primary" Margin="0,0,8,0" />
                    <ui:Button Content="Cancel" Click="OnCancel" Appearance="Secondary"
                               ToolTip="Apply nothing at all" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
