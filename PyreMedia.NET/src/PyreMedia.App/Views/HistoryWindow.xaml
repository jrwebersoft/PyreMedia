<ui:FluentWindow x:Class="PyreMedia.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Rename history"
        Height="640" Width="1080"
        MinHeight="380" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Rename history" ShowMaximize="True" />

        <Grid Grid.Row="1" Margin="20,4,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" x:Name="TxtSearch"
                        PlaceholderText="Filter by title or filename..."
                        TextChanged="OnFilterChanged" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" x:Name="TxtCount" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>

        <DataGrid Grid.Row="2" x:Name="Grid" Margin="20,0,20,0"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderThickness="0" Background="Transparent"
                  SelectionMode="Extended"
                  RowBackground="Transparent" AlternatingRowBackground="Transparent"
                  SelectionChanged="OnSelectionChanged">
            <DataGrid.Columns>
                <!-- The tick is the row's own selection, so clicking it, ctrl-clicking
                     rows and shift-selecting a run all stay in agreement with no
                     second list to keep in step. -->
                <DataGridTemplateColumn Width="44" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.Header>
                        <CheckBox x:Name="ChkAll" ToolTip="Select all / none"
                                  Checked="OnCheckAll" Unchecked="OnCheckAll"
                                  HorizontalAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      PreviewMouseLeftButtonDown="OnTickClicked"
                                      IsChecked="{Binding IsSelected, Mode=OneWay,
                                                  RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="When" Binding="{Binding Entry.Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                    Width="130" />
                <DataGridTextColumn Header="Action" Binding="{Binding Entry.Action}" Width="90" />
                <DataGridTextColumn Header="Title" Binding="{Binding Entry.Title}" Width="150" />
                <DataGridTextColumn Header="Was" Binding="{Binding Entry.OldName}" Width="*" />
                <DataGridTextColumn Header="Became" Binding="{Binding Entry.NewName}" Width="*" />
                <DataGridTextColumn Header="Can revert" Binding="{Binding Describe}" Width="220" />
                <DataGridTextColumn Header="Batch" Binding="{Binding Entry.BatchId}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSelection" FontSize="12" />
                    <TextBlock x:Name="TxtPath" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="BtnClearAll" Content="Clear all" Click="OnClearAll"
                               Appearance="Secondary" Margin="0,0,8,0"
                               ToolTip="Empty the whole log. Files are not touched." />
                    <ui:Button x:Name="BtnForget" Content="Remove from log" Icon="{ui:SymbolIcon Delete24}"
                               Click="OnForgetSelected" Appearance="Secondary" Margin="0,0,8,0" IsEnabled="False"
                               ToolTip="Delete these rows from the log. Files are not touched." />
                    <ui:Button x:Name="BtnRevertBatch" Content="Revert whole batch" Click="OnRevertBatch"
                               Appearance="Secondary" Margin="0,0,8,0" IsEnabled="False" />
                    <ui:Button x:Name="BtnRevert" Content="Revert selected" Icon="{ui:SymbolIcon ArrowUndo24}"
                               Click="OnRevertSelected" Appearance="Primary" Margin="0,0,8,0" IsEnabled="False" />
                    <ui:Button Content="Close" Click="OnClose" Appearance="Secondary" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
