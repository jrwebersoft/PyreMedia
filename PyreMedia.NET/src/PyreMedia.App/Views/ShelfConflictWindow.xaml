<ui:FluentWindow x:Class="PyreMedia.App.Views.ShelfConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Some names are already taken"
        Height="620" Width="960"
        MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Some names are already taken" ShowMaximize="True" />

        <Border Grid.Row="1" Margin="16,4,16,10" Padding="14,12" CornerRadius="6"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock x:Name="TxtWhat" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="The same issue often arrives twice from different scanners, so the sizes are worth comparing - the bigger file is usually the better scan. Replacing sends the existing file to the Recycle Bin. Keeping both files the incoming one beside it under a free name. All of it undoes from History." />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="All:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:Button Content="Skip" Click="OnAllSkip" Appearance="Secondary"
                               Margin="0,0,6,0" Padding="12,6" />
                    <ui:Button Content="Replace" Click="OnAllReplace" Appearance="Secondary"
                               Margin="0,0,6,0" Padding="12,6" />
                    <ui:Button Content="Keep both" Click="OnAllKeepBoth" Appearance="Secondary"
                               Padding="12,6" />
                    <ui:Button Content="Keep the bigger one" Click="OnAllBigger"
                               Appearance="Secondary" Margin="12,0,0,0" Padding="12,6"
                               ToolTip="Replace where the incoming file is bigger, skip where it is not" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ui:Card Grid.Row="2" Margin="16,0,16,10" Padding="0">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0"
                      Background="Transparent" RowBackground="Transparent"
                      AlternatingRowBackground="Transparent"
                      FontSize="12" RowHeight="30" ColumnHeaderHeight="30"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Coming in" Binding="{Binding Incoming}"
                                        IsReadOnly="True" Width="2*" MinWidth="140" />
                    <DataGridTextColumn Header="Size" Binding="{Binding IncomingSize}"
                                        IsReadOnly="True" Width="Auto" MinWidth="60" />
                    <DataGridTextColumn Header="Already there" Binding="{Binding Existing}"
                                        IsReadOnly="True" Width="2*" MinWidth="140" />
                    <DataGridTextColumn Header="Size" Binding="{Binding ExistingSize}"
                                        IsReadOnly="True" Width="Auto" MinWidth="60" />

                    <DataGridTemplateColumn Header="What to do" Width="Auto" MinWidth="200"
                                            CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,0">
                                    <RadioButton Content="Skip" Margin="0,0,10,0"
                                                 GroupName="{Binding Group}"
                                                 IsChecked="{Binding IsSkip, Mode=TwoWay}" />
                                    <RadioButton Content="Replace" Margin="0,0,10,0"
                                                 GroupName="{Binding Group}"
                                                 IsChecked="{Binding IsReplace, Mode=TwoWay}" />
                                    <RadioButton Content="Keep both"
                                                 GroupName="{Binding Group}"
                                                 IsChecked="{Binding IsKeepBoth, Mode=TwoWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ui:Card>

        <Border Grid.Row="3" Padding="16,6,16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="TxtSummary" VerticalAlignment="Center"
                           FontSize="12" TextWrapping="Wrap" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="Go ahead" Appearance="Primary" Click="OnGo"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Cancel" Appearance="Secondary" Click="OnCancel" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
