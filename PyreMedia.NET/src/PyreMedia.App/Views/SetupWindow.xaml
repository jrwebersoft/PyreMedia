<ui:FluentWindow x:Class="PyreMedia.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:PyreMedia.App.Controls"
        Title="Set up PyreMedia"
        Icon="../pyremedia.ico"
        Height="760" Width="900"
        MinHeight="480" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Set up PyreMedia" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="VideoClipMultiple24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border Grid.Row="1" Margin="24,4,24,16">
            <StackPanel>
                <TextBlock x:Name="TxtStepTitle" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock x:Name="TxtStepBlurb" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ProgressBar x:Name="Steps" Height="3" Margin="0,14,0,0" Minimum="0" Maximum="4" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="24,0,24,0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <Grid>
                <!-- ================= 1. Tools ================= -->
                <StackPanel x:Name="PageTools">
                    <ItemsControl x:Name="ToolList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,0,12" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                                           VerticalAlignment="Center" />
                                                <Border Margin="10,0,0,0" Padding="8,1" CornerRadius="9"
                                                        Background="{Binding StatusBrush}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                               Foreground="White" />
                                                </Border>
                                                <!-- Every tool says how much it matters. The optional
                                                     one being absent is the normal state, and without
                                                     a label it reads as something gone wrong. -->
                                                <Border Margin="6,0,0,0" Padding="8,1" CornerRadius="9"
                                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                    <TextBlock Text="{Binding NeedLabel}" FontSize="10" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Why}" FontSize="12" TextWrapping="Wrap"
                                                       Margin="0,6,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                            <!-- Say where it comes from before offering to install it -->
                                            <TextBlock Text="{Binding Publisher}" FontSize="11" TextWrapping="Wrap"
                                                       Margin="0,6,0,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                            <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                                                       Margin="0,6,0,0"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                            <TextBlock Text="{Binding Without}" FontSize="11" TextWrapping="Wrap"
                                                       Margin="0,6,0,0"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       Visibility="{Binding ShowWithout, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                            <ui:Button Content="Install" Icon="{ui:SymbolIcon ArrowDownload24}"
                                                       Appearance="Primary" Width="120" Margin="0,0,0,6"
                                                       Tag="{Binding}" Click="OnInstallTool"
                                                       Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}"
                                                       IsEnabled="{Binding IsIdle}" />
                                            <ui:Button Content="Download" Icon="{ui:SymbolIcon Globe24}"
                                                       Appearance="Secondary" Width="120" Margin="0,0,0,6"
                                                       Tag="{Binding}" Click="OnOpenDownload"
                                                       Visibility="{Binding ShowDownload, Converter={StaticResource BoolToVis}}" />
                                            <ui:Button Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}"
                                                       Appearance="Secondary" Width="120"
                                                       Tag="{Binding}" Click="OnBrowseTool"
                                                       Visibility="{Binding ShowDownload, Converter={StaticResource BoolToVis}}"
                                                       ToolTip="Point at the executable yourself if it isn't on PATH" />
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:Card Padding="14" Margin="0,0,0,12"
                             Visibility="{Binding ElementName=ToolLog, Path=Text, Converter={StaticResource NullToVis}}">
                        <StackPanel>
                            <TextBlock Text="Installer output" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock x:Name="ToolLog" FontSize="11" TextWrapping="Wrap"
                                       FontFamily="Cascadia Mono, Consolas"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:Card>

                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="BtnRecheck" Content="Check again"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Click="OnRecheck" Appearance="Secondary"
                                   ToolTip="Re-read PATH and look for each tool again - use this after installing one yourself" />
                        <TextBlock x:Name="TxtChecked" VerticalAlignment="Center" Margin="12,0,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- ================= 2. Keys ================= -->
                <StackPanel x:Name="PageKeys" Visibility="Collapsed">
                    <ui:Card Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,14"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Both are free, and both are yours rather than this app's - a key is tied to the account that registered it, so no key can be shipped in the program. Registering takes a couple of minutes." />

                            <TextBlock Text="TMDb" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,2,0,6"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Required. Every search goes through TMDb, for both TV and film, and it supplies all film metadata and artwork. Without this key nothing can be matched." />
                            <ui:HyperlinkButton Content="Get a TMDb key  -  themoviedb.org/settings/api"
                                                NavigateUri="https://www.themoviedb.org/settings/api"
                                                Margin="0,0,0,6" Padding="0,2" />
                            <ui:TextBox x:Name="TxtSetupTmdb" PlaceholderText="Paste your TMDb API key (v3 auth)"
                                        Margin="0,0,0,16" />

                            <TextBlock Text="TheTVDB" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,2,0,6"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Optional. Episode data only. It carries season-0 specials that TMDb often omits, and numbers some long-running shows differently - useful when a library was built against those numbers. Leave it empty to use TMDb alone." />
                            <ui:HyperlinkButton Content="Get a TheTVDB key  -  thetvdb.com/api-information/signup"
                                                NavigateUri="https://thetvdb.com/api-information/signup"
                                                Margin="0,0,0,6" Padding="0,2" />
                            <ui:TextBox x:Name="TxtSetupTvdb" PlaceholderText="Paste your TheTVDB API key (optional)"
                                        Margin="0,0,0,4" />

                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Stored in settings.json under %APPDATA%\PyreMedia, on this machine only. Changeable later in Settings." />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!-- ================= 2. Folders ================= -->
                <StackPanel x:Name="PageFolders" Visibility="Collapsed">
                    <ui:Card Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="TV and films go in the same list. Each item is classified from what's inside it, so a mixed staging folder works without sorting it first."
                                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <ListBox x:Name="FolderList" Height="220" BorderThickness="0"
                                     Background="Transparent" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ui:Button Content="Add folder" Icon="{ui:SymbolIcon FolderAdd24}"
                                           Click="OnAddFolder" Appearance="Primary" Margin="0,0,8,0" />
                                <ui:Button Content="Remove" Icon="{ui:SymbolIcon Delete24}"
                                           Click="OnRemoveFolder" Appearance="Secondary" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                Title="Nothing is changed without your approval"
                                Message="Scanning only reads. Every rename appears as a tickable row you approve before anything is written, and can be undone afterwards from History." />
                </StackPanel>

                <!-- ================= 3. Options ================= -->
                <StackPanel x:Name="PageOptions" Visibility="Collapsed">
                    <ui:Card Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Languages" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="Which tracks remuxing keeps. Everything else is offered for removal, listed row by row - never removed silently, and never leaving a file with no audio at all."
                                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <TextBlock Text="Your language" FontWeight="SemiBold" FontSize="12"
                                       Margin="0,0,0,2" />
                            <TextBlock Text="Used to flag files that don't contain it, and to decide which forced subtitles matter."
                                       TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ctl:LanguagePicker x:Name="PickLang" SingleSelect="True" AllowEmpty="False"
                                                Margin="0,0,0,16" MaxWidth="420"
                                                HorizontalAlignment="Left" />

                            <TextBlock Text="Keep these audio languages" FontWeight="SemiBold" FontSize="12"
                                       Margin="0,0,0,6" />
                            <ctl:LanguagePicker x:Name="PickAudio" Margin="0,0,0,16" MaxWidth="420"
                                                HorizontalAlignment="Left" />

                            <TextBlock Text="Keep these subtitle languages" FontWeight="SemiBold" FontSize="12"
                                       Margin="0,0,0,6" />
                            <ctl:LanguagePicker x:Name="PickSubs" Margin="0,0,0,16" MaxWidth="420"
                                                HorizontalAlignment="Left" />

                            <CheckBox x:Name="ChkKeepUnd" Margin="0,0,0,6"
                                      Content="Keep tracks with no language tag" />
                            <TextBlock Text="Recommended. Older rips often tag nothing at all, and dropping those would take the only audio with them."
                                       TextWrapping="Wrap" FontSize="11" Margin="26,0,0,10"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                            <CheckBox x:Name="ChkKeepForced" Margin="0,0,0,6"
                                      Content="Always keep forced subtitles in your language" />
                            <TextBlock Text="Recommended. Forced subtitles carry dialogue you're meant to read - alien speech, foreign scenes - and losing them makes parts of a film unintelligible."
                                       TextWrapping="Wrap" FontSize="11" Margin="26,0,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Remuxing" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <CheckBox x:Name="ChkMkv" Margin="0,0,0,8"
                                      Content="Always output Matroska (.mkv)" />
                            <TextBlock Text="Recommended. MKV carries Dolby Vision, 3D and PGS subtitles that MP4 handles badly or not at all, and it is the only container mkvmerge writes - so choosing it routes files through the safer engine."
                                       TextWrapping="Wrap" FontSize="11" Margin="26,0,0,12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                            <CheckBox x:Name="ChkArchive" Margin="0,0,0,8"
                                      Content="Keep the original of every remuxed file" />
                            <TextBlock Text="Strongly recommended. The original is moved aside rather than deleted, so any remux can be reversed."
                                       TextWrapping="Wrap" FontSize="11" Margin="26,0,0,12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                            <StackPanel Orientation="Horizontal" Margin="26,0,0,0">
                                <TextBlock Text="Keep them in" VerticalAlignment="Center" Width="124" />
                                <ui:TextBox x:Name="TxtArchive" Width="300" />
                                <ui:Button Content="Browse..." Click="OnBrowseArchive"
                                           Appearance="Secondary" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Leave blank to keep each original in a folder beside the file it came from."
                                       TextWrapping="Wrap" FontSize="11" Margin="26,6,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Padding="16">
                        <StackPanel>
                            <TextBlock Text="Naming" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <CheckBox x:Name="ChkMoveTv" Margin="0,0,0,8"
                                      Content="Move episodes into Season folders" />
                            <CheckBox x:Name="ChkMovieFolder" Margin="0,0,0,8"
                                      Content="Give each film its own folder" />
                            <CheckBox x:Name="ChkNfo" Margin="0,0,0,8"
                                      Content="Write Kodi .nfo files beside each match" />
                            <CheckBox x:Name="ChkArt"
                                      Content="Download poster and fanart beside each match" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!-- ================= 4. Done ================= -->
                <StackPanel x:Name="PageDone" Visibility="Collapsed">
                    <ui:Card Padding="24">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="40"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="Ready" FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock x:Name="TxtSummary" TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="0,12,0,0" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="All of this can be changed later in Settings, and Settings has a Reset to defaults if you ever want to start over."
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0" Content="Skip setup" Click="OnSkip" Appearance="Secondary"
                           ToolTip="Use defaults and configure later in Settings" />

                <TextBlock Grid.Column="1" x:Name="TxtWarn" VerticalAlignment="Center"
                           Margin="16,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button x:Name="BtnBack" Content="Back" Click="OnBack"
                               Appearance="Secondary" Margin="0,0,8,0" />
                    <ui:Button x:Name="BtnNext" Content="Next" Icon="{ui:SymbolIcon ArrowRight24}"
                               Click="OnNext" Appearance="Primary" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
