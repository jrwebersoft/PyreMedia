<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PyreMedia</AssemblyName>
    <RootNamespace>PyreMedia.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>pyremedia.ico</ApplicationIcon>
    <Version>2.1.0</Version>
    <Product>PyreMedia</Product>

    <!-- What Windows shows under the file's Details tab. -->
    <Company>JRWeberSoft</Company>
    <Authors>JRWeberSoft</Authors>
    <AssemblyTitle>PyreMedia</AssemblyTitle>
    <Description>Renames and organises TV and film files, and strips unwanted tracks by remuxing.</Description>
    <Copyright>Created by JRWeberSoft. Private build - not for redistribution.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PyreMedia.Core\PyreMedia.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also as a resource, so windows and the taskbar use it at runtime and
         not just the .exe in Explorer. -->
    <Resource Include="pyremedia.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!--
    The manual, carried inside the exe.

    It is one self-contained page with its pictures already embedded, so putting
    it in the binary costs a couple of megabytes and means the program can never
    be somewhere its own documentation is not. A build handed to somebody is one
    file again rather than a file and a note about the other file.

    Conditional because the manual is generated by a tool that builds against
    this project: a checkout that has never run it still compiles, and About
    says where it looked instead of finding nothing. Regenerating the manual and
    rebuilding is what puts the new one in.
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\docs\PyreMedia-Manual.html')">
    <EmbeddedResource Include="..\..\..\docs\PyreMedia-Manual.html"
                      LogicalName="PyreMedia.Manual.html" />
  </ItemGroup>

  <!--
    A private build carries its owner's API keys in this file, beside the exe,
    read at startup to fill in any key the settings have not got. It is never
    written back, and it is in .gitignore in both trees.

    Conditional on purpose. The published source has no such file, and this must
    build cleanly without one rather than failing on a missing item - a build
    that needs a secret to compile is a build nobody else can make.

    Copied on every build so a clean rebuild does not silently produce an exe
    that has forgotten its keys.

    Set EmbedKeys=false to build the same source without them. That is how the
    shareable copy is made: one command produces both, from identical code, so
    the clean one cannot drift from the one actually being used.
  -->
  <ItemGroup Condition="'$(EmbedKeys)' != 'false' And Exists('keys.local.json')">
    <None Include="keys.local.json" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>

