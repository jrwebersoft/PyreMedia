<ui:FluentWindow x:Class="PyreMedia.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:PyreMedia.App.ViewModels"
        xmlns:views="clr-namespace:PyreMedia.App.Views"
        mc:Ignorable="d"
        Title="PyreMedia"
        Icon="pyremedia.ico"
        Height="820" Width="1400"
        MinHeight="360" MinWidth="380"
        WindowStartupLocation="Manual"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="PyreMedia" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="VideoClipMultiple24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Video and audio are different jobs on different files, so they are
             different tabs rather than one list filtered two ways. Inside each,
             the filter narrows: all video / tv / movies, all audio / music /
             audiobooks. -->
        <TabControl Grid.Row="1" x:Name="Tabs" Margin="8,0,8,0" BorderThickness="0"
                    Background="Transparent">

            <TabItem Header="Video">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

        <!-- Toolbar: mode switch + actions + live status -->
        <Border Grid.Row="0" Padding="16,2,16,10">
            <Grid x:Name="ToolbarGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Filter: items are classified automatically, this only narrows the view -->
                <Border Grid.Column="0" CornerRadius="6" Margin="0,0,14,0" Padding="3"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="All video" GroupName="Filter" Padding="12,4"
                                     IsChecked="{Binding FilterAll, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="all"
                                     Style="{StaticResource ModeToggle}" />
                        <RadioButton Content="TV" GroupName="Filter" Padding="12,4"
                                     IsChecked="{Binding FilterTv, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="tv"
                                     Style="{StaticResource ModeToggle}" />
                        <RadioButton Content="Movies" GroupName="Filter" Padding="12,4"
                                     IsChecked="{Binding FilterMovies, Mode=OneWay}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="movies"
                                     Style="{StaticResource ModeToggle}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Icon="{ui:SymbolIcon FolderAdd24}" Content="Add folder"
                               Click="OnAddFolder" Appearance="Secondary" Margin="0,0,8,0" />
                    <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="Scan"
                               Command="{Binding ScanCommand}" Appearance="Primary" Margin="0,0,8,0" />
                    <ui:Button Icon="{ui:SymbolIcon FolderArrowRight24}" Content="Move completed"
                               Click="OnMoveCompletedVideo" Appearance="Secondary" />

                    <!-- Fills in what existing .nfo files are short of, looking
                         each title up by the id it already carries. It says what
                         it found before it writes anything. -->
                    <ui:Button Icon="{ui:SymbolIcon PersonAdd24}" Content="Fill in gaps"
                               Click="OnFillGaps" Appearance="Secondary" Margin="8,0,0,0" />

                    <!-- Only there when there is something to clear, so it never
                         reads as an invitation to delete something. -->
                    <ui:Button Icon="{ui:SymbolIcon FolderProhibited20}"
                               Content="{Binding LeftoverLabel}" Margin="8,0,0,0"
                               Click="OnClearLeftovers" Appearance="Secondary"
                               Visibility="{Binding HasLeftovers, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Status: deliberately prominent -->
                <!-- Moved to its own row when narrow: squeezed between the
                     buttons it clipped to "1 c". -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0,0,0"
                            x:Name="StatusPanel" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <WrapPanel Grid.Column="3" Orientation="Horizontal">
                    <ui:Button Icon="{ui:SymbolIcon Wand24}" Content="Remux"
                               Click="OnOpenRemux" Appearance="Secondary" Margin="0,0,8,0"
                               ToolTip="Strip unwanted audio and subtitle tracks from every scanned file" />
                    <ui:Button Icon="{ui:SymbolIcon History24}" Content="History"
                               Click="OnOpenHistory" Appearance="Secondary" Margin="0,0,8,0" />
                    <ui:Button Icon="{ui:SymbolIcon Settings24}" Content="Settings"
                               Click="OnOpenSettings" Appearance="Secondary" Margin="0,0,8,0" />
                    <ui:Button Icon="{ui:SymbolIcon DarkTheme24}" Click="OnToggleTheme"
                               Appearance="Secondary" Margin="0,0,8,0" ToolTip="Toggle light/dark" />
                    <ui:Button Icon="{ui:SymbolIcon Wrench24}" Click="OnOpenSetup"
                               Appearance="Secondary" Margin="0,0,8,0"
                               ToolTip="Re-run setup: check tools, folders and the main options" />
                    <ui:Button Icon="{ui:SymbolIcon Info24}" Click="OnOpenAbout"
                               Appearance="Secondary"
                               ToolTip="Version, sources, tools and where files are kept" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Result banner.
             Floats over the panels rather than sitting in a row of its own. It
             was in an Auto row above the * row that holds them, so every time
             it opened or closed the whole workspace changed height - and a
             search does both in one go, clearing the old message on the way in
             and setting a new one on the way out. Clicking a row that found no
             match resized the library list twice under the pointer, which is
             what "it scrolls down then back up" was.

             Floating it costs the space it covers, so it does not take clicks
             with it: an InfoBar is hit-testable, and this one sits over the
             library heading and the top edge of the first row - which is where
             you reach next, since it opens exactly when a search found nothing.
             Not hit-testable, so a click goes to the list underneath. That also
             costs the close button, which cannot be clicked through a bar that
             takes no input; no loss, because every banner here is replaced by
             the next action and cleared outright by selecting another row.

             Rows 1 and 2 of this grid are spare now. They are left in place
             because everything below is addressed by index. -->
        <ui:InfoBar Grid.Row="3" Panel.ZIndex="20" VerticalAlignment="Top"
                    Margin="16,0,16,10"
                    IsHitTestVisible="False"
                    IsOpen="{Binding HasBanner, Mode=OneWay}"
                    Message="{Binding BannerText}"
                    Severity="{Binding BannerIsError, Converter={StaticResource BoolToSeverity}}" />

        <!-- Three columns: list | match | changes -->
        <ScrollViewer Grid.Row="3" x:Name="PanelScroll" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled" Padding="0">
        <Grid Margin="16,0,16,0" x:Name="PanelGrid">
            <Grid.ColumnDefinitions>
                <!-- Shares of the window rather than fixed strips.
                     At 270 and 330 pixels the two lists stayed those sizes on a
                     3120-pixel monitor while every spare pixel went to the
                     Changes pane, which had nothing to do with it: the library
                     was a narrow column of clipped titles next to an acre of
                     empty space. The splitters still work - dragging one fixes
                     it at whatever width you chose. -->
                <ColumnDefinition Width="1.1*" MinWidth="220" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1.3*" MinWidth="280" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2.2*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- ===== 1. Library ===== -->
            <ui:Card Grid.Column="0" Padding="0" x:Name="CardLibrary"
                     PreviewMouseWheel="OnSectionWheel">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding ItemsHeader}" FontWeight="SemiBold"
                               Margin="14,12,14,8" />

                    <!-- IsSynchronizedWithCurrentItem MUST be false. Bound to an
                         ICollectionView it defaults to true, which ties selection to the
                         view's currency pointer - so a Refresh() or a filter re-evaluation
                         silently moves the selection off whatever was clicked. -->
                    <ListView Grid.Row="1" ItemsSource="{Binding ItemsView}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              IsSynchronizedWithCurrentItem="False"
                              SelectionMode="Single"
                              BorderThickness="0" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch">
                        <!-- The container gets a complete template rather than a fixed
                             height on the content. Styling only the content left the
                             theme's own padding around it, so the visible chip and the
                             clickable container weren't the same rectangle and clicks
                             near an edge landed on the neighbour. Here the Border IS the
                             container, so what you see is exactly what you hit.
                             No BasedOn: "{StaticResource {x:Type ListViewItem}}" doesn't
                             resolve under the WPF-UI theme and threw on every launch. -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="56" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <!-- Selection is read from the accent bar, not
                                                 from the wash behind it. The theme's two
                                                 fills differ by about two percent of white
                                                 over Mica, and they were the wrong way
                                                 round: hover (#15FFFFFF) was brighter than
                                                 selected (#0FFFFFFF). Clicking a row made it
                                                 dimmer, and whichever row the pointer then
                                                 rested on looked like the selected one.
                                                 Reported as clicking Strange New Worlds and
                                                 getting Stranger Things - they are adjacent
                                                 rows and both trim to "Stran...". -->
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    CornerRadius="6"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <!-- The bar overlays rather than taking a
                                                         column, so the text sits in the same
                                                         place selected or not. A row that
                                                         shifts under the pointer is how a
                                                         click lands on the wrong one. -->
                                                    <ContentPresenter Margin="12,8,10,8"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Stretch" />
                                                    <Border x:Name="Pip" Width="3"
                                                            HorizontalAlignment="Left"
                                                            Margin="3,10,0,10" CornerRadius="2"
                                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                            Visibility="Hidden" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- Hover only where it is not already the
                                                     selected row. Unguarded, the neighbour
                                                     under the pointer repainted brighter
                                                     than the selection itself. -->
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True" />
                                                        <Condition Property="IsSelected" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                </MultiTrigger>
                                                <!-- Last, so it wins while hovered too. -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Pip" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LibraryItem}">
                                <!-- No fixed height here: the container defines the row.
                                     StatusLine is always populated so the two lines never
                                     collapse and rows stay a consistent size. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border CornerRadius="3" Padding="5,1" Margin="0,0,6,0"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <!-- Single always-present line: file count until matched,
                                                 then the matched title. Height never changes. -->
                                            <TextBlock Text="{Binding StatusLine}" FontSize="11"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <!-- Foreign audio present -->
                                            <Border CornerRadius="3" Padding="5,1" Margin="6,0,0,0"
                                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                    Visibility="{Binding HasForeign, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Contains audio in another language - use Remux to strip it">
                                                <TextBlock Text="{Binding ForeignBadge}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                            </Border>

                                            <!-- What the file carries. Shown only when there is
                                                 something to say: one audio track and no subtitles
                                                 is ordinary, and printing it on every row would
                                                 bury the files worth looking at. -->
                                            <Border CornerRadius="3" Padding="5,1" Margin="6,0,0,0"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    Visibility="{Binding HasTrackBadge, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="{Binding TrackTooltip}">
                                                <TextBlock Text="{Binding TrackBadge}" FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <ui:SymbolIcon Grid.Column="1" Symbol="CheckmarkCircle24" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ui:Card>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" x:Name="Split1" />

            <!-- ===== 2. Match ===== -->
            <ui:Card Grid.Column="2" Padding="0" x:Name="CardMatch"
                     PreviewMouseWheel="OnSectionWheel">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="14,12,14,8">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Match" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <!-- Override when auto-detection guessed wrong -->
                            <Border HorizontalAlignment="Right" CornerRadius="5" Padding="2"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="TV" GroupName="Kind" Padding="10,2" FontSize="11"
                                                 IsChecked="{Binding SearchAsTv, Mode=OneWay}"
                                                 Command="{Binding SetSearchKindCommand}" CommandParameter="tv"
                                                 Style="{StaticResource ModeToggle}" />
                                    <RadioButton Content="Movie" GroupName="Kind" Padding="10,2" FontSize="11"
                                                 IsChecked="{Binding SearchAsMovie, Mode=OneWay}"
                                                 Command="{Binding SetSearchKindCommand}" CommandParameter="movie"
                                                 Style="{StaticResource ModeToggle}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" PlaceholderText="Title"
                                        Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                        KeyDown="OnSearchKeyDown" Margin="0,0,6,0" />
                            <ui:TextBox Grid.Column="1" PlaceholderText="Year" Width="70"
                                        Text="{Binding SearchYear, UpdateSourceTrigger=PropertyChanged}"
                                        KeyDown="OnSearchKeyDown" />
                        </Grid>
                        <ui:Button Content="Search" Icon="{ui:SymbolIcon Search24}"
                                   Command="{Binding SearchCommand}" Appearance="Secondary"
                                   HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                    </StackPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}"
                             SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" Margin="0,0,0,6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SearchResultItem}">
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="64" Height="96" CornerRadius="4"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold" FontSize="14"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Ids}" FontSize="11" Margin="0,1,0,2"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{Binding ShortOverview}" FontSize="11"
                                                   TextWrapping="Wrap" MaxHeight="46"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </ui:Card>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" x:Name="Split2" />

            <!-- ===== 3. Changes ===== -->
            <ui:Card Grid.Column="4" Padding="0" x:Name="CardChanges"
                     PreviewMouseWheel="OnSectionWheel">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Matched title, with large art, so the match is confirmed visually
                         before anything is applied. -->
                    <!-- Wrap, don't scroll. A horizontal ScrollViewer here let the
                         text grow instead of wrapping, which produced the very
                         scrollbar it was meant to avoid. -->
                    <Border Grid.Row="0" Padding="14,14,14,12"
                            Visibility="{Binding SelectedResult, Converter={StaticResource NullToVis}}"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="190" Height="285" CornerRadius="8"
                                    Margin="0,0,20,0"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Image Source="{Binding SelectedResult.PosterUrl}" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedResult.Display}"
                                           FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedResult.Ids}" FontSize="12" Margin="0,4,0,8"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{Binding SelectedResult.ShortOverview}" FontSize="13"
                                           TextWrapping="Wrap" MaxHeight="96" LineHeight="19"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <!-- Sources disagree on some shows (Battlestar's
                                     specials, for one). Pin the right one per show. -->
                                <WrapPanel Orientation="Horizontal" Margin="0,12,0,0"
                                           Visibility="{Binding CanPinSource, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Episode numbering:" FontSize="11" VerticalAlignment="Center"
                                               Margin="0,0,8,4"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Border CornerRadius="5" Padding="2"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="Merged" GroupName="Pin" Padding="10,2" FontSize="11"
                                                         IsChecked="{Binding PinIsMerged, Mode=OneWay}"
                                                         Command="{Binding PinSourceCommand}" CommandParameter="Merged"
                                                         Style="{StaticResource ModeToggle}" />
                                            <RadioButton Content="TMDb" GroupName="Pin" Padding="10,2" FontSize="11"
                                                         IsChecked="{Binding PinIsTmdb, Mode=OneWay}"
                                                         Command="{Binding PinSourceCommand}" CommandParameter="TMDb"
                                                         Style="{StaticResource ModeToggle}" />
                                            <RadioButton Content="TheTVDB" GroupName="Pin" Padding="10,2" FontSize="11"
                                                         IsChecked="{Binding PinIsTvdb, Mode=OneWay}"
                                                         Command="{Binding PinSourceCommand}" CommandParameter="TheTVDB"
                                                         Style="{StaticResource ModeToggle}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- The -1/0/+1 offset used to live here. It's
                                         now "Shift all by" on the Renumber
                                         screen, alongside title matching and
                                         per-file control, rather than two
                                         renumbering mechanisms in two places.
                                         Shown here only when one is already set,
                                         so an existing offset stays visible. -->
                                    <Border CornerRadius="4" Padding="8,2" Margin="16,0,0,0"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            Visibility="{Binding HasOffset, Converter={StaticResource BoolToVis}}"
                                            ToolTip="A constant shift is applied to this show. Change it under Renumber.">
                                        <TextBlock Text="{Binding OffsetLabel}" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- One column, three stacked bands: the heading, what the
                         file carries, then the buttons.
                         Side by side, the track callout - which names every
                         audio and subtitle language in the file - had no width
                         limit and simply took the row, pushing Play and the
                         per-item Remux off the window entirely. Nothing that
                         varies in length now shares a line with a button. -->
                    <StackPanel Grid.Row="1" Margin="14,12,14,8">
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Changes" FontWeight="SemiBold" />

                            <!-- Trimmed, with the whole of it on hovering. This
                                 line names every subtitle language in the file,
                                 and on Reacher that is thirty-eight of them -
                                 one unbroken line long enough to push the row's
                                 buttons out of the window. -->
                            <TextBlock Text="{Binding PreviewSummary}" FontSize="11" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding PreviewSummary}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        </Grid>

                        <!-- What this item carries. Its own band, trimmed, with
                             the whole of it on hovering - it is a sentence, and
                             it was standing where the buttons go. -->
                        <TextBlock Text="{Binding SelectedItem.TrackCallout}"
                                   FontSize="11" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="{Binding SelectedItem.TrackTooltip}"
                                   Visibility="{Binding SelectedItem.HasTrackCallout, Converter={StaticResource BoolToVis}}" />

                        <!-- Wrapping, so a narrow pane gets two short rows of
                             buttons instead of one row running off the edge.
                             Play and the per-item Remux live here, and losing
                             them off the right is losing the two things most
                             worth doing to the file you are looking at. -->
                        <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <!-- Watch a few seconds of it. The fastest way to answer "which
                                 episode is this?" for a disc rip, where the filename says
                                 nothing and the metadata says less. -->
                            <ui:Button x:Name="BtnPlay" Content="Play"
                                       Icon="{ui:SymbolIcon Play24}" Click="OnPlay"
                                       Appearance="Secondary" Margin="0,0,10,6" Padding="10,3"
                                       Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}}" />

                            <!-- Scoped to the selected item, so a 100-episode show is one click -->
                            <ui:Button x:Name="BtnItemTracks" Content="{Binding TracksButtonText}"
                                       Icon="{ui:SymbolIcon Wand24}" Click="OnOpenRemuxForItem"
                                       Appearance="Secondary" Margin="0,0,10,6" Padding="10,3"
                                       Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}}"
                                       ToolTip="Strip unwanted audio and subtitle tracks from this item's files" />
                            <!-- Header, not the footer: the footer hides once a
                                 plan is complete, and "already correct by the
                                 filename but wrong in reality" is exactly when
                                 renumbering is needed. -->
                            <!-- Only once a match is chosen: without one there is no
                                 title to ask TMDb about. -->
                            <ui:Button x:Name="BtnArtwork" Content="Artwork"
                                       Icon="{ui:SymbolIcon Image24}" Click="OnOpenArtwork"
                                       Appearance="Secondary" Margin="0,0,10,6" Padding="10,3"
                                       Visibility="{Binding SelectedResult, Converter={StaticResource NullToVis}}"
                                       ToolTip="Choose the poster, fanart and clear logo saved beside these files" />
                            <ui:Button x:Name="BtnRenumber2" Content="Renumber"
                                       Icon="{ui:SymbolIcon NumberSymbol24}" Click="OnOpenRenumber"
                                       Appearance="Secondary" Margin="0,0,10,6" Padding="10,3"
                                       Visibility="{Binding CanRenumber, Converter={StaticResource BoolToVis}}"
                                       ToolTip="Match episodes by title, switch numbering source, or set numbers by hand" />
                            <ui:Button Content="All" Command="{Binding SelectAllCommand}"
                                       Appearance="Secondary" Margin="0,0,6,6" Padding="10,3"
                                       Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}" />
                            <ui:Button Content="None" Command="{Binding SelectNoneCommand}"
                                       Appearance="Secondary" Margin="0,0,6,6" Padding="10,3"
                                       Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}" />

                            <!-- Only when there are some. Deletions are offered
                                 unticked, and "All" was the only way to accept
                                 them - which meant accepting every rename too. -->
                            <ui:Button Content="{Binding UntickedJunkText}" Command="{Binding SelectLeftoversCommand}"
                                       Appearance="Secondary" Margin="0,0,10,6" Padding="10,3"
                                       Visibility="{Binding HasUntickedJunk, Converter={StaticResource BoolToVis}}"
                                       ToolTip="Tick the sample clips and release leftovers found beside these files" />

                            <!-- For a file that is already named correctly.
                                 Apply only ever runs on changes, so once an
                                 item was organised there was no way to fetch
                                 its .nfo or its artwork again - and those are
                                 the two things you most often want redone: a
                                 wrong poster, a sidecar written before the
                                 match was corrected, artwork deleted by
                                 something else. -->
                            <ui:Button x:Name="BtnRedoSidecars" Content="Redo .nfo and artwork"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Click="OnRedoSidecars"
                                       Appearance="Secondary" Padding="10,3"
                                       Visibility="{Binding SelectedResult, Converter={StaticResource NullToVis}}"
                                       ToolTip="Write the Kodi .nfo and download the artwork again for this item's files" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Folder rename, called out because it affects the whole item -->
                    <Border Grid.Row="2" Padding="12,10" Margin="14,0,14,8" CornerRadius="4"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            Visibility="{Binding HasFolderRename, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding RenameFolderChecked, Mode=TwoWay}"
                                          VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ui:SymbolIcon Symbol="Folder24" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Rename folder" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding FolderRenameText}" Margin="24,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding FolderRenameProblem}" Margin="24,2,0,0" FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding FolderRenameProblem, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Done panel replaces the grid -->
                    <Border Grid.Row="3" Padding="24" VerticalAlignment="Center"
                            Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="36" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="Organised" FontWeight="SemiBold" FontSize="16"
                                       HorizontalAlignment="Center" Margin="0,10,0,4" />
                            <TextBlock Text="{Binding CompleteText}" TextWrapping="Wrap" MaxWidth="420"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:Button Content="Next" Icon="{ui:SymbolIcon ArrowRight24}"
                                       Command="{Binding NextItemCommand}" Appearance="Primary"
                                       HorizontalAlignment="Center" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Explains an empty grid rather than showing bare headers -->
                    <Border Grid.Row="3" Padding="24" VerticalAlignment="Center"
                            Visibility="{Binding ShowEmptyPreview, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Info24" FontSize="28" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding EmptyPreviewText}" TextWrapping="Wrap" MaxWidth="380"
                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding Preview}"
                              Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="36" CanUserSort="False">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="IsEnabled" Value="{Binding CanSelect}" />
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>

                            <DataGridTextColumn Header="Ep" Binding="{Binding EpisodeLabel}"
                                                Width="52" IsReadOnly="True" />

                            <DataGridTemplateColumn Header="Change" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{Binding SourceName}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="-> " Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                                <TextBlock Text="{Binding TargetDisplay}" TextTrimming="CharacterEllipsis"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Auto, not a fixed width: "Rename, into new folder"
                                 was being clipped mid-word at 150px. -->
                            <DataGridTextColumn Header="Status" Binding="{Binding ActionLabel}"
                                                Width="Auto" MinWidth="110" IsReadOnly="True" />

                            <!-- Per file, next to the file.
                                 A season is twenty rows, and wanting to deal
                                 with one of them - the episode with the stray
                                 commentary track, the one from another source -
                                 is the normal case. Scoping only to the whole
                                 show meant finding that episode again in a list
                                 of twenty once the window opened. -->
                            <DataGridTemplateColumn Header="" Width="Auto" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,0">
                                            <ui:Button Icon="{ui:SymbolIcon Play24}"
                                                       Click="OnPlayOne" Tag="{Binding}"
                                                       Appearance="Secondary" Padding="7,2"
                                                       Margin="0,0,4,0" FontSize="11"
                                                       ToolTip="Play this file" />
                                            <ui:Button Icon="{ui:SymbolIcon Wand24}"
                                                       Click="OnRemuxOne" Tag="{Binding}"
                                                       Appearance="Secondary" Padding="7,2"
                                                       FontSize="11"
                                                       ToolTip="Strip tracks from this one file" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="4" Padding="14,10"
                            Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <!-- Wraps so Apply stays reachable when the panel is narrow -->
                        <WrapPanel Orientation="Horizontal">
                            <ui:Button Content="Apply" Icon="{ui:SymbolIcon Checkmark24}"
                                       Command="{Binding ApplyCommand}" Appearance="Primary"
                                       FontSize="14" Padding="20,7" />

                            <CheckBox Content="Move to next automatically" VerticalAlignment="Center"
                                      Margin="14,0,0,0"
                                      IsChecked="{Binding AutoAdvance, Mode=TwoWay}" />
                            <!-- Why Apply is greyed out. Without this the button
                                 just looks broken. -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="14,0,0,0"
                                        Visibility="{Binding ShowWaitingHint, Converter={StaticResource BoolToVis}}">
                                <ui:SymbolIcon Symbol="Info24" FontSize="15" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{Binding WaitingHint}" VerticalAlignment="Center"
                                           Margin="7,0,0,0" FontSize="11" TextWrapping="Wrap" MaxWidth="360"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11"
                                       TextWrapping="Wrap" MaxWidth="320"
                                       Visibility="{Binding ShowWaitingHint, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Applies the ticked changes to disk. Undo them later from History." />
                        </WrapPanel>
                    </Border>
                </Grid>
            </ui:Card>
            </Grid>
        </ScrollViewer>

        <Expander Grid.Row="4" Header="Log" Margin="16,10,16,4" IsExpanded="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox Grid.Row="0" x:Name="LogList" ItemsSource="{Binding Log}" Height="130"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11"
                         BorderThickness="0" Background="Transparent" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <ui:Button Content="Open log file" Icon="{ui:SymbolIcon DocumentText24}"
                               Click="OnOpenLog" Appearance="Secondary" Padding="10,4" />
                    <TextBlock x:Name="LogPathText" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Expander>
                </Grid>
            </TabItem>

            <TabItem Header="Audio">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Same shape as the video filter above it: the widest
                         option first, then the two kinds it splits into. -->
                    <Border Grid.Row="0" Padding="16,8,16,4" HorizontalAlignment="Left">
                        <Border CornerRadius="6" Padding="3"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="AudioAll" Checked="OnAudioFilter" Tag="all" Content="All audio" GroupName="AudioFilter"
                                             IsChecked="True" Padding="12,4"
                                             Style="{StaticResource ModeToggle}" />
                                <RadioButton x:Name="AudioMusic" Checked="OnAudioFilter" Tag="music" Content="Music" GroupName="AudioFilter"
                                             Padding="12,4" Style="{StaticResource ModeToggle}" />
                                <RadioButton x:Name="AudioBooks" Checked="OnAudioFilter" Tag="books" Content="Audiobooks" GroupName="AudioFilter"
                                             Padding="12,4" Style="{StaticResource ModeToggle}" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <views:MusicView Grid.Row="1" x:Name="MusicPane" />
                </Grid>
            </TabItem>

            <!-- Books brings its own filter row, because comics and ebooks
                 split differently from the way audio does. -->
            <TabItem Header="Books">
                <views:BooksView x:Name="BooksPane" Margin="0,8,0,0" />
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
